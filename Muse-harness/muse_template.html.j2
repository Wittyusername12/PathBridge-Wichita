<script>
/* ═══ Campaign Reach Calculator — slider-driven reach model ═══ */
var CALC_MODEL = {{ calc_model | default({}) | tojson | built }};
if(CALC_MODEL && CALC_MODEL.digital_base){(function(){
  var M=CALC_MODEL;
  var sBudget=document.getElementById("calcBudget");
  var sPartner=document.getElementById("calcPartners");
  if(!sBudget||!sPartner)return;

  /* Configure sliders from Python-injected ranges */
  sBudget.min=M.ranges.budget_min;sBudget.max=M.ranges.budget_max;
  sBudget.step=M.ranges.budget_step;sBudget.value=M.defaults.budget;
  sPartner.min=M.ranges.partner_min;sPartner.max=M.ranges.partner_max;
  sPartner.step=M.ranges.partner_step;sPartner.value=M.defaults.partners;

  /* AnimNum — animated number with shared rAF loop + interrupt support
     (Adapted from Oracle template's proven AnimatedNumber pattern) */
  var animSet=new Set(),animRaf=null;
  function animTick(ts){animSet.forEach(function(a){a._frame(ts)});
    animRaf=animSet.size>0?requestAnimationFrame(animTick):null}
  function AnimNum(el,opts){
    opts=opts||{};this.el=el;this.dur=opts.duration||280;
    this.prefix=opts.prefix||"";this.suffix=opts.suffix||"";
    this.dec=opts.decimals||0;this.cur=opts.initial||0;
    this.start=this.cur;this.end=this.cur;this.t0=null;this.active=false;
    this._render(this.cur)
  }
  AnimNum.prototype.set=function(v){
    if(v===this.end&&!this.active)return;
    this.start=this.cur;this.end=v;this.t0=null;
    if(!this.active){this.active=true;animSet.add(this);
      if(!animRaf)animRaf=requestAnimationFrame(animTick)}
  };
  AnimNum.prototype._frame=function(ts){
    if(!this.t0)this.t0=ts;
    var p=Math.min((ts-this.t0)/this.dur,1);
    var e=1-Math.pow(1-p,3); /* ease-out-cubic */
    this.cur=this.start+(this.end-this.start)*e;
    this._render(this.cur);
    if(p>=1){this.cur=this.end;this._render(this.end);
      this.active=false;animSet.delete(this)}
  };
  AnimNum.prototype._render=function(v){
    var a=Math.abs(v).toFixed(this.dec);
    var parts=a.split(".");
    parts[0]=parts[0].replace(/\B(?=(\d{3})+(?!\d))/g,",");
    this.el.textContent=this.prefix+(v<0?"-":"")+parts.join(".")+this.suffix
  };

  /* computeReach — additive power-law model; every coefficient a setting of this tool (BUILD IC-4, D6: no outside source):
     digital scales with budget^0.6 (diminishing returns)
     community scales linearly with partner count
     QR = community × 3% × awareness (floored at 1.0; digital only ADDS, never penalizes)
     enrollments: split rates — digital 0.03% + community 0.10% + 1 referral/partner
     CPA = budget/enrollments (not bounded; far from the base case it is labelled) */
  function computeReach(budget,partners){
    var dReach=M.digital_base*Math.pow(budget/M.base_budget,M.budget_exp);
    var cReach=M.community_base*(partners/M.base_partners);
    var imp=Math.round(dReach+cReach);
    /* Awareness: digital ads amplify offline actions (a setting of this tool).
       Floor at 1.0: below-baseline spend removes boost, doesn't penalize organic reach. */
    var awareness=Math.max(1.0,1+0.3*(budget/M.base_budget-1));
    var qr=Math.round(cReach*M.qr_rate*awareness);
    /* Split conversion: community impressions convert 3.3× better than digital (trusted context) */
    var enroll=Math.round(dReach*M.digital_enroll_rate+cReach*M.community_enroll_rate+partners*M.referrals_per_partner);
    enroll=Math.max(enroll,1);
    var cpa=budget/enroll;
    return {imp:imp,qr:qr,enroll:enroll,cpa:Math.round(cpa)}
  }

  /* Initialize animated numbers with base-case values */
  var initR=computeReach(M.defaults.budget,M.defaults.partners);
  var baseR=initR; /* Store baseline for delta calculations */
  var animImp=new AnimNum(document.getElementById("calcImpVal"),{initial:initR.imp});
  var animQR=new AnimNum(document.getElementById("calcQRVal"),{initial:initR.qr});
  var animEnroll=new AnimNum(document.getElementById("calcEnrollVal"),{initial:initR.enroll});
  var animCPA=new AnimNum(document.getElementById("calcCPAVal"),{prefix:"$",initial:initR.cpa});
  var calcHint=document.getElementById("calcHint");

  /* Delta display helper: shows "▲ +34% vs base" or "▼ -18% vs base" */
  function showDelta(elId,current,baseline,invert){
    var el=document.getElementById(elId);
    if(!el||current===baseline){el.textContent="";el.className="calc-metric-delta";return}
    var pct=Math.round((current-baseline)/Math.max(baseline,1)*100);
    var arrow=pct>0?"▲":"▼";var sign=pct>0?"+":"";
    /* For CPA, lower is better: invert the color logic */
    var cls=invert?(pct<0?"delta-up":"delta-down"):(pct>0?"delta-up":"delta-down");
    if(pct===0)cls="delta-neutral";
    el.textContent=arrow+" "+sign+pct+"% vs base";
    el.className="calc-metric-delta "+cls
  }

  /* Slider fill gradient — accent color fills from left to thumb position */
  function updateFill(slider){
    var pct=((slider.value-slider.min)/(slider.max-slider.min))*100;
    slider.style.backgroundSize=pct+"% 100%"
  }
  updateFill(sBudget);updateFill(sPartner);

  /* Format helpers for slider value labels */
  function fmtBudget(v){return "$"+Number(v).toLocaleString("en-US")}
  function fmtPartner(v){return v}

  /* Display initial value labels */
  document.getElementById("calcBudgetVal").textContent=fmtBudget(M.defaults.budget);
  document.getElementById("calcPartnerVal").textContent=fmtPartner(M.defaults.partners);

  /* Unified input handler — called on every slider tick */
  function onInput(){
    var budget=parseInt(sBudget.value);
    var partners=parseInt(sPartner.value);
    updateFill(sBudget);updateFill(sPartner);
    document.getElementById("calcBudgetVal").textContent=fmtBudget(budget);
    document.getElementById("calcPartnerVal").textContent=fmtPartner(partners);

    var r=computeReach(budget,partners);
    animImp.set(r.imp);animQR.set(r.qr);animEnroll.set(r.enroll);animCPA.set(r.cpa);
    /* BUILD IC-4 (D6): no clamp — a cost per enrollment far from the base case's (over 5x, under a fifth) shows, labelled */
    var cpaNote=document.getElementById("calcCPANote");
    if(cpaNote){var far=baseR.cpa>0&&(r.cpa>5*baseR.cpa||r.cpa<baseR.cpa/5);
      cpaNote.textContent=far?"far from the base case — a result of these settings, not a measured cost":"acquisition cost"}

    /* Delta indicators: % change from baseline (research: all 4 sources recommend) */
    var modified=budget!==M.defaults.budget||partners!==M.defaults.partners;
    if(modified){
      showDelta("calcImpDelta",r.imp,baseR.imp,false);
      showDelta("calcQRDelta",r.qr,baseR.qr,false);
      showDelta("calcEnrollDelta",r.enroll,baseR.enroll,false);
      showDelta("calcCPADelta",r.cpa,baseR.cpa,true); /* CPA inverted: lower=better=green */
    } else {
      ["calcImpDelta","calcQRDelta","calcEnrollDelta","calcCPADelta"].forEach(function(id){
        var el=document.getElementById(id);if(el){el.textContent="";el.className="calc-metric-delta"}});
    }

    /* Hide hint text after first interaction */
    if(calcHint&&modified)calcHint.classList.add("hidden");

    var cpaEl=document.getElementById("calcCPAVal");
    cpaEl.classList.remove("cpa-good","cpa-warn","cpa-high");     /* no colour band: a fixed cut-off of no source would judge the result */

    /* ARIA: update valuetext so screen readers announce meaningful labels */
    sBudget.setAttribute("aria-valuetext",fmtBudget(budget)+" monthly budget");
    sPartner.setAttribute("aria-valuetext",partners+" community partners");

    /* Modified border glow when sliders differ from defaults */
    document.querySelectorAll(".calc-metric").forEach(function(c){
      c.classList.toggle("modified",modified)});
    document.getElementById("calcReset").classList.toggle("show",modified);
  }
  sBudget.addEventListener("input",onInput);
  sPartner.addEventListener("input",onInput);

  /* Reset button */
  document.getElementById("calcReset").addEventListener("click",function(){
    sBudget.value=M.defaults.budget;sPartner.value=M.defaults.partners;
    onInput();
  });
})()}
</script>

<script>
/* ═══ Accordion Timeline — true accordion, always-one-open ═══ */
(function(){
  var tl=document.querySelector('.timeline');
  if(!tl)return;
  function getTriggers(){return[].slice.call(tl.querySelectorAll('.phase-trigger'))}
  function togglePhase(trigger){
    if(trigger.getAttribute('aria-expanded')==='true')return;
    getTriggers().forEach(function(t){
      var phase=t.closest('.phase');
      var isTarget=t===trigger;
      phase.classList.toggle('is-open',isTarget);
      t.setAttribute('aria-expanded',String(isTarget));
    });
  }
  tl.addEventListener('click',function(e){
    var trigger=e.target.closest('.phase-trigger');
    if(trigger&&tl.contains(trigger))togglePhase(trigger);
  });
  tl.addEventListener('keydown',function(e){
    var trigger=e.target.closest('.phase-trigger');
    if(!trigger||!tl.contains(trigger))return;
    var list=getTriggers();var idx=list.indexOf(trigger);
    switch(e.key){
      case'ArrowDown':e.preventDefault();list[(idx+1)%list.length].focus();break;
      case'ArrowUp':e.preventDefault();list[(idx-1+list.length)%list.length].focus();break;
      case'Home':e.preventDefault();list[0].focus();break;
      case'End':e.preventDefault();list[list.length-1].focus();break;
    }
  });
})();
</script>
