    q("#gh-clear").addEventListener("click",custom);
    q("#gh-wizard").addEventListener("submit",function(e){e.preventDefault();fromWizard()});
    q("#gh-wizard").addEventListener("change",function(e){var x=e.target;if(!(x instanceof HTMLInputElement)||x.type!=="checkbox"||!x.checked)return;
      var fs=x.closest(".gh-step"),st=fs&&STEPS[+fs.getAttribute("data-step")];if(!st||!st.options)return;
      var o=st.options[+x.value],none=o&&Array.isArray(o.value)&&!o.value.length;     /* "None of these" excludes the others, and they it */
      qa("input[type=checkbox]",fs).forEach(function(y){if(y===x)return;var oy=st.options[+y.value],ny=oy&&Array.isArray(oy.value)&&!oy.value.length;if(none||ny)y.checked=false})});
    var ask=q("#gh-ask");
    if(ask)ask.addEventListener("click",function(){var t=askText();if(!t)return;var tg=document.getElementById("chat-toggle"),inp=document.getElementById("chat-q");
      if(tg&&tg.style.display!=="none"&&document.getElementById("chatbot").style.display==="none")tg.click();if(inp){inp.value=t;inp.focus()}});
    if(RD){load();if(CUR){var ci=B.presets.map(function(p){return p.id}).indexOf(CUR);if(ci>=0){loadPreset(ci)}}else switchRS(false);
      q("#gh-rsteps").addEventListener("change",function(e){var x=e.target;if(!(x instanceof HTMLInputElement))return;
        if(x.name==="gh-rdoc"){if(x.checked)RS.docs[x.value]=true;else delete RS.docs[x.value]}
        else{var fs=x.closest("[data-rstep]");if(fs)RS.steps[+fs.getAttribute("data-rstep")]=+x.value}
        save();readiness()});
      q("#gh-rclear").addEventListener("click",function(){RS={steps:{},docs:{}};ALL[who()]=RS;save();paintSteps();readiness()});
      var s=q("#gh-rsave");if(s)s.insertAdjacentHTML("afterend",'<p class="gh-sub" id="gh-rstore">'+(STORE==="blocked"?"Not saved: this browser does not allow storage here (the tracker still works on this page).":"")+"</p>");
    }
    showStep(0);update();
    console.info("Get Help: "+STEPS.length+" questions, "+B.presets.length+" presets, "+B.sets.length+" option sets; open now read at "+stamp(now()));
  }catch(e){console.warn("Get Help: not wired —",e)}
  window.GetHelp={state:function(){return {preset:H.preset,attrs:H.attrs,need:H.need,shown:H.shown,store:STORE,rs:RS,people:Object.keys(ALL)}},render:render,askText:askText};
})();
</script>
{% endraw %}{% endif %}
</body>
</html>
