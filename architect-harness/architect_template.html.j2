        {% if oracle_url|default('') %}<a class="xtrack-btn" href="{{ oracle_url | e }}" target="_blank" rel="noopener"><span class="xt-icon">📊</span> See the Business Case → Oracle</a>{% endif %}
        {% if muse_url|default('') %}<a class="xtrack-btn" href="{{ muse_url | e }}" target="_blank" rel="noopener"><span class="xt-icon">🎨</span> See the Outreach Campaign → Muse</a>{% endif %}
