{% raw %}
<script>
// ═══════════════════════════════════════════════════════════════════════════
// Civic Operations Dashboard v3
// Architecture: State store + render() + event delegation + cross-filtering
// Fixes: cross-filter, ZIP limit, event cap, sort, maps, KPIs, fade, favicon
// ═══════════════════════════════════════════════════════════════════════════
const $=s=>document.querySelector(s),$$=s=>document.querySelectorAll(s);
// BUILD IC-5 (D2 g): text escaped for markup's text and for a quoted attribute alike — & < > " ' as entities. The textContent →
// innerHTML serialisation it replaces escapes & < > only, so a quote in a value it filled closed the attribute (data-zip, value, …).
const esc=s=>String(s??"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
// Reduced-motion preference (cached once; Perplexity §1d, Gemini §2.4)
const _rmq=window.matchMedia('(prefers-reduced-motion: reduce)');

// ── State store ──────────────────────────────────────────────────────────
const S={status:"loading",resources:[],zips:{},hints:{},zipStats:[],crisisEvents:[],
  chartFields:[],areaLabel:"ZIP",domainHints:{},
  q:"",cats:new Set(),sortMode:"smart",selId:null,showClosed:false,
  boolToggles:{},enumSel:{},geoCenter:null,snapshotAsof:"",derivedTiles:[]};

function upd(p){Object.assign(S,p);renderFinder()}

// ── Geo: haversine distance (miles) ──────────────────────────────────────
function hav(a1,o1,a2,o2){
  const R=3958.8,d=Math.PI/180,da=(a2-a1)*d,dl=(o2-o1)*d;
  const a=Math.sin(da/2)**2+Math.cos(a1*d)*Math.cos(a2*d)*Math.sin(dl/2)**2;
  return R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
}

// FIX #4: Compute geographic center of all ZIP centroids so distance sort
// works even without a user-entered ZIP (Audit 4 finding)
function computeGeoCenter(zips){
  const coords=Object.values(zips);
  if(!coords.length)return null;
  const lat=coords.reduce((s,c)=>s+c[0],0)/coords.length;
  const lng=coords.reduce((s,c)=>s+c[1],0)/coords.length;
  return[lat,lng];
}

function getDist(refPoint,r){
  if(!refPoint)return null;
  const l=r?.location;if(!l)return null;
  if(l.lat!=null&&l.lng!=null)return hav(refPoint[0],refPoint[1],l.lat,l.lng);
  const rc=S.zips[l.zip];return rc?hav(refPoint[0],refPoint[1],rc[0],rc[1]):null;
}

function relScore(q,r){
  if(!q)return 0;
  const t=q.toLowerCase().split(/\s+/).filter(Boolean),h=r.search_text||"";
  let s=0;for(const w of t)if(h.includes(w))s++;
  if(r.name?.toLowerCase().includes(q.toLowerCase()))s+=3;
  return s;
}

// ── Filter + Sort (FIX #4: distance without ZIP uses geoCenter) ──────────
function filtered(){
  const q=S.q.trim(),isZ=/^\d{5}$/.test(q),uz=isZ?q:null;
  // Reference point: user ZIP centroid if available, else geographic center
  const refPoint=uz?S.zips[uz]:
    (S.sortMode==="distance"?S.geoCenter:null);

  let f=S.resources.filter(r=>{
    if(r.status==="closed"&&!S.showClosed)return false;
    if(S.cats.size>0&&!S.cats.has(r.category))return false;
    for(const[k,v]of Object.entries(S.boolToggles)){if(!v)continue;if(r.attrs?.[k]!==true)return false}
    for(const[k,sel]of Object.entries(S.enumSel)){if(!sel||!sel.size)continue;
      const rv=r.attrs?.[k];const vs=Array.isArray(rv)?rv.map(String):[String(rv??"")];
      let ok=false;for(const s of sel)if(vs.includes(s))ok=true;if(!ok)return false}
    if(q&&!isZ&&relScore(q,r)===0)return false;
    return true;
  });

  const sc=f.map(r=>({r,rel:isZ?0:relScore(q,r),d:refPoint?getDist(refPoint,r):null}));
  const m=S.sortMode;
  sc.sort((a,b)=>{
    if(m==="name")return(a.r.name||"").localeCompare(b.r.name||"");
    if(m==="distance")return(a.d??1e9)-(b.d??1e9)||(a.r.name||"").localeCompare(b.r.name||"");
    // Smart: ZIP → distance; keyword → relevance; empty → alphabetical
    if(isZ)return(a.d??1e9)-(b.d??1e9)||(a.r.name||"").localeCompare(b.r.name||"");
    if(q)return(b.rel-a.rel)||(a.r.name||"").localeCompare(b.r.name||"");
    return(a.r.name||"").localeCompare(b.r.name||"");
  });
  return{isZ,uz,refPoint,items:sc};
}

// ── Render: Finder ───────────────────────────────────────────────────────
function renderFinder(){
  const st=$("#st-text"),sh=$("#st-hint"),re=$("#results");
  if(S.status!=="ready"){st.textContent=S.status==="error"?"Error":"Loading…";return}
  const{isZ,uz,refPoint,items}=filtered(),c=items.length,
    tot=S.resources.filter(r=>r.status!=="closed"||S.showClosed).length;
  st.textContent=`${c} of ${tot} resources`;
  sh.textContent=isZ?`Sorted by distance from ${uz}`:
    (S.sortMode==="distance"?"Sorted by distance from center":
    (S.q?"By relevance":"Alphabetical"));
  if(!c){re.innerHTML=`<div class="state"><div class="t">No resources match</div><div class="b">${S.q?"Try different terms. ":""}${S.cats.size?"Remove filters. ":""}</div></div>`;return}
  const fg=document.createDocumentFragment(),lim=Math.min(c,50);
  for(let i=0;i<lim;i++){const{r,d:dd}=items[i];const cd=document.createElement("div");
    cd.className="card"+(r.id===S.selId?" sel":"")+(r.status==="closed"?" closed":"");
    cd.dataset.id=r.id;cd.tabIndex=0;cd.setAttribute("role","button");
    cd.style.animationDelay=`${i*30}ms`; // Staggered fade-in
    const ds=dd!=null?`${dd.toFixed(1)} mi`:"";
    /* P0.7 (D6, D7): who closed it (the data or the announcement), the data's "at risk", a record the curveball added or changed */
    const cb=r.status==="closed"?`<span class="bdg cl" title="${r.closed_by==="announcement"?"Closed by the curveball announcement":"Closed per the data's own status"}">CLOSED</span>`:"";
    const xb=(r.at_risk?'<span class="bdg risk">At risk</span>':"")+(r.changed_at_curveball?'<span class="bdg chg">Changed at the curveball</span>':"");
    cd.innerHTML=`<div class="nm">${esc(r.name)} ${cb}</div><div class="mt">${esc(r.category)}${r.location?.address?" · "+esc(r.location.address):""}${ds?" · "+ds:""}</div><div class="badges"><span class="bdg cat">${esc(r.category)}</span>${xb}</div>`;
    fg.appendChild(cd)}
  if(c>lim){const m=document.createElement("div");m.className="state";m.innerHTML=`<div class="b">${c-lim} more — refine your search</div>`;fg.appendChild(m)}
  re.innerHTML="";re.appendChild(fg);
}

// ── Render: Detail panel (FIX #5: Google Maps directions) ────────────────
function renderDetail(r){
  $("#d-title").textContent=r.name;
  $("#d-sub").textContent=r.category+(r.location?.zip?" · ZIP "+r.location.zip:"");
  const cl=$("#d-closed");
  cl.innerHTML=r.status==="closed"?`<div class="dclosed"><strong>⚠ CLOSED</strong> — ${r.closed_by==="announcement"?"by the curveball announcement: ":""}${esc(r.closed_reason||"This resource has been marked as closed.")}</div>`:(r.at_risk?`<div class="dclosed" style="border-color:rgba(245,158,11,.4);background:rgba(245,158,11,.08)"><strong>At risk</strong> — per the data's own status</div>`:"")+(r.status!=="closed"&&r.status_note?`<div class="dclosed" style="border-color:rgba(245,158,11,.4);background:rgba(245,158,11,.08)"><strong>To confirm</strong> — ${esc(r.status_note)}</div>`:"");
  const kv=$("#d-kv");let h="";
  // Priority order per Excellence Report §5: critical → barrier → operational
  if(r.location?.address)h+=`<div class="k">Address</div><div class="v">${esc(r.location.address)}</div>`;
  if(r.location?.zip)h+=`<div class="k">ZIP</div><div class="v">${esc(r.location.zip)}</div>`;
  // Show barrier-relevant attrs first (hours, phone, language, ID)
  const priority=['Hours','Open Hours','Phone','Language','Languages','Id Required','Accepts'];
  const shown=new Set();
  // Helper: format attr values (Root Cause 5: zero → "None" for time fields; Root Cause 6: skip internal IDs)
  const _skipAttrs=new Set(['area code','areacode']);
  const _timeKeys=new Set(['wait weeks','wait days','wait time']);
  const _fmtVal=(k,v)=>{
    if(Array.isArray(v))return v.join(", ");
    if(typeof v==="boolean")return v?"Yes":"No";
    if(v===0&&_timeKeys.has(k.toLowerCase()))return "None";
    return String(v);
  };
  // Color-coded wait times: red >4wk, amber 2-4wk, green ≤2wk or "None"
  const _waitColor=(k,v)=>{
    if(!_timeKeys.has(k.toLowerCase()))return "";
    if(v===0||v==="None")return "#22c55e";  // green — no wait
    if(typeof v==="number"&&v<=2)return "#22c55e"; // green
    if(typeof v==="number"&&v<=4)return "var(--warn)"; // amber
    if(typeof v==="number"&&v>4)return "var(--bad)";   // red
    return "";
  };
  for(const pk of priority){
    for(const[k,v]of Object.entries(r.attrs||{})){
      if(_skipAttrs.has(k.toLowerCase().replace(/\s/g,'')))continue;
      if(k.toLowerCase().replace(/\s/g,'')===pk.toLowerCase().replace(/\s/g,'')&&!shown.has(k)){
        shown.add(k);const wc=_waitColor(k,v);
        h+=`<div class="k">${esc(k)}</div><div class="v"${wc?' style="color:'+wc+';font-weight:700"':''}>${esc(_fmtVal(k,v))}</div>`}}}
  // Then remaining attrs
  for(const[k,v]of Object.entries(r.attrs||{})){
    if(shown.has(k))continue;
    if(_skipAttrs.has(k.toLowerCase().replace(/\s/g,'')))continue;
    const wc=_waitColor(k,v);
    h+=`<div class="k">${esc(k)}</div><div class="v"${wc?' style="color:'+wc+';font-weight:700"':''}>${esc(_fmtVal(k,v))}</div>`;}
  kv.innerHTML=h;
  // Google Maps directions link + nearest alternatives — now ABOVE attrs
  const acts=$("#d-actions");
  let actHtml="";
  if(r.location?.address){
    const addr=encodeURIComponent(r.location.address);
    actHtml+=`<a class="directions" href="https://www.google.com/maps/dir/?api=1&destination=${addr}" target="_blank" rel="noopener">📍 Get Directions</a>`;
  }
  // Filter-aware nearest alternatives: apply active filters so count reflects user's search intent
  if(r.location?.lat&&r.location?.lng){
    // Helper: does resource match active category/bool/enum filters?
    const _matchesFilters=o=>{
      if(o.status==="closed"&&!S.showClosed)return false;
      if(S.cats.size>0&&!S.cats.has(o.category))return false;
      for(const[k,v]of Object.entries(S.boolToggles)){if(!v)continue;if(o.attrs?.[k]!==true)return false}
      for(const[k,sel]of Object.entries(S.enumSel)){if(!sel||!sel.size)continue;
        const rv=o.attrs?.[k];const vs=Array.isArray(rv)?rv.map(String):[String(rv??"")];
        let ok=false;for(const s of sel)if(vs.includes(s))ok=true;if(!ok)return false}
      return true;
    };
    const allNearby=S.resources.filter(o=>o.id!==r.id&&o.location?.lat&&o.location?.lng&&hav(r.location.lat,r.location.lng,o.location.lat,o.location.lng)<=5);
    const filteredNearby=allNearby.filter(_matchesFilters);
    const hasActiveFilters=S.cats.size>0||Object.values(S.boolToggles).some(v=>v)||Object.values(S.enumSel).some(s=>s&&s.size>0);
    if(allNearby.length>0){
      const cats=[...new Set(filteredNearby.map(n=>n.category))].slice(0,3).join(", ");
      if(hasActiveFilters&&filteredNearby.length!==allNearby.length){
        actHtml+=`<div style="margin-top:8px;font-size:12px;color:var(--muted)">📊 <strong>${filteredNearby.length}</strong> matching nearby · ${allNearby.length} total within 5 miles${cats?' ('+esc(cats)+')':''}</div>`;
      }else{
        const catList=[...new Set(allNearby.filter(n=>n.status!=="closed").map(n=>n.category))].slice(0,3).join(", ");
        actHtml+=`<div style="margin-top:8px;font-size:12px;color:var(--muted)">📊 <strong>${allNearby.filter(n=>n.status!=="closed").length}</strong> other resource${allNearby.filter(n=>n.status!=="closed").length>1?"s":""} within 5 miles${catList?' ('+esc(catList)+')':''}</div>`;
      }
    }
  }
  if(actHtml)actHtml=`<div style="margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid var(--border)">${actHtml}</div>`;
  acts.innerHTML=actHtml;
  $("#det").classList.add("active");
}

// ── FIX #1: Cross-filtering (Excellence Report §2) ──────────────────────
let chartsRendered=false;
function switchToTab(tabName){
  $$(".tab").forEach(t=>t.classList.toggle("active",t.dataset.tab===tabName));
  $$(".tab-panel").forEach(p=>p.classList.toggle("active",p.id==="panel-"+tabName));
  // Scroll to top on tab switch (Perplexity §1e: simultaneous with transition)
  try{window.scrollTo({top:0,left:0,behavior:_rmq.matches?'auto':'smooth'})}catch(e){window.scrollTo(0,0)}
  // Lazy render charts when Data Explorer tab is first shown
  if(tabName==="data"&&!chartsRendered){chartsRendered=true;setTimeout(renderCharts,50)}
}
function crossFilterZip(zip){
  // Set search to this ZIP, switch to Finder tab, trigger search
  const input=$("#q");input.value=zip;
  switchToTab("finder");
  upd({q:zip});
  input.focus();
}

// P0.7 (D5): an alert from the data, whatever its endpoint is named — its title and id, then its severity, date, detail, places and
// groups (the caller escapes both strings)
function alertText(e){
  const title=`⚠ ${e.name||"Alert"}${e.id?" ("+e.id+")":""}`;
  const parts=[];if(e.severity)parts.push(e.severity);if(e.date)parts.push(e.date);
  if(e.detail)parts.push(e.detail.length>120?e.detail.slice(0,117)+"…":e.detail);
  if(e.places&&e.places.length)parts.push("Places: "+e.places.join(", "));
  if(e.category)parts.push("Affects: "+e.category);
  return[title,parts.join(" · ")]}

// ── Render: Dashboard (fully domain-adaptive) ───────────────────────────
function renderDashboard(){
  // ══ SYSTEM-SNAPSHOT MODE — capacity-focused dashboard for aggregate system data ══
  // Activates when community-snapshot endpoint provides system-wide metrics
  // (e.g., Wichita homelessness data: PIT counts, bed totals, foster youth rates)
  const snap=S.systemSnapshot||{};
  /* P0.6 (D11): this mode runs only when every field it draws is a number, and draws each as given (no stand-in values) */
  const SNAP_FIELDS=["shelteredAndUnshelteredTotal","totalEmergencyBeds","bedsAvailableNow","shelteredOrTransitional","unshelteredHeadcount",
    "avgDaysToHousing","nationalDaysToHousing","fosterHomelessnessAge17","fosterHomelessnessAge19","fosterHomelessnessAge21"];
  if(SNAP_FIELDS.every(k=>typeof snap[k]==="number")){
    // BUILD IC-5 (D2 g): numbers by the guard above; Number() says so where each is read (the sink test reads no guard)
    const totalHomeless=Number(snap.shelteredAndUnshelteredTotal);
    const beds=Number(snap.totalEmergencyBeds);
    const avail=Number(snap.bedsAvailableNow);
    const sheltered=Number(snap.shelteredOrTransitional);
    const unsheltered=Number(snap.unshelteredHeadcount);
    const daysToHousing=Number(snap.avgDaysToHousing);
    const nationalDays=Number(snap.nationalDaysToHousing);
    const fosterAge17=Math.round(snap.fosterHomelessnessAge17*100);
    const fosterAge19=Math.round(snap.fosterHomelessnessAge19*100);
    const fosterAge21=Math.round(snap.fosterHomelessnessAge21*100);
    const blocked=beds-avail;
    const blockedPct=beds>0?Math.round(blocked/beds*100):0;

    // ── Hero banner ── P0.7 (D4): in Block 2, when this endpoint did not change at the curveball, its figures say "as of Block 1"
    const asof=S.snapshotAsof?` <span class="asof" style="font-size:11px;color:var(--muted);font-style:italic">(${esc(S.snapshotAsof)})</span>`:"";
    const hero=$("#hero-crisis");
    hero.innerHTML=`<span style="color:var(--bad)">${totalHomeless.toLocaleString("en-US")} People</span> Experiencing Homelessness · Only <span style="color:var(--warn)">${avail} of ${beds}</span> Beds Available · <span style="color:var(--bad)">${fosterAge21}%</span> of Foster Youth Face Homelessness by 21${asof}`;

    // ── KPI cards ──
    const kpis=[
      {label:"People Homeless",num:totalHomeless,fmt:n=>n.toLocaleString("en-US"),sub:`${sheltered.toLocaleString("en-US")} sheltered · ${unsheltered.toLocaleString("en-US")} unsheltered`,cls:"red"},
      {label:"Beds Available",num:avail,fmt:n=>n+" / "+beds,sub:`${blockedPct}% of beds not available in the data`,cls:"amber"},
      {label:"Days to Housing",num:daysToHousing,fmt:n=>n+" days",sub:`${nationalDays-daysToHousing} days faster than national avg (${nationalDays})`,cls:"green"},
      {label:"Foster Youth at Risk",num:fosterAge21,fmt:n=>n+"%",sub:`${fosterAge17}% at 17 → ${fosterAge19}% at 19 → ${fosterAge21}% by 21`,cls:"red"},
    ];
    if(S.snapshotAsof)kpis.forEach(k=>{k.sub+=`<span class="asof">${esc(S.snapshotAsof)}</span>`});
    // P0.7 (D4): each figure the Oracle derived from the records, in its OWN tile beside the aggregate — its value, its base, its records;
    // nothing moves from one tile to the other and no ratio mixes them
    for(const t of S.derivedTiles){
      const base=t.base!=null?" of "+t.base:"";const recs=Array.isArray(t.records)?t.records.join(", "):"all records";
      kpis.push({label:esc(t.label),num:Number(t.value),fmt:n=>n+base,cls:"blue",
        sub:`Block 1: ${esc(String(t.block1))}${t.base1!=null?" of "+esc(String(t.base1)):""} · ${esc(String(t.field))}${t.minus?" − "+esc(String(t.minus)):""} over ${Number(t.n)} record(s) of ${esc(String(t.endpoint))} (${esc(recs)})<span class="asof">records selected by the Oracle's analysis; summed by Python</span>`})}
    // P0.7 (D6): the curveball KPI counts only the announcement's closures; a closure in the data is the data's
    const annClosed=S.resources.filter(r=>r.status==="closed"&&r.closed_by==="announcement");
    if(annClosed.length>0){const names=[...new Set(annClosed.map(r=>r.name))].slice(0,2).join(", ");kpis.push({label:"⚠ Curveball Impact",num:annClosed.length,fmt:n=>String(n),sub:esc(names)||"Resources closed by the announcement",cls:"red"})}
    $("#kpi-bar").innerHTML=kpis.map((k,i)=>`<div class="kpi ${k.cls}"><div class="label">${k.label}</div><div class="val" data-target="${k.num}" data-idx="${i}">0</div><div class="sub">${k.sub}</div></div>`).join("");
    setTimeout(()=>{$$(".kpi .val[data-target]").forEach(el=>{
      const target=parseInt(el.dataset.target)||0;const idx=parseInt(el.dataset.idx)||0;
      const fmt=kpis[idx]?.fmt||(n=>String(n));
      if(target===0){el.textContent=fmt(0);return}
      const dur=600;const t0=performance.now();
      function step(t){const p=Math.min(1,(t-t0)/dur);const ease=1-Math.pow(1-p,3);
        el.textContent=fmt(Math.round(target*ease));
        if(p<1)requestAnimationFrame(step)}
      requestAnimationFrame(step)})},50);

    // ── Bed accessibility bar (replaces severity distribution) ──
    const sevBar=$("#sev-bar");
    const accessPct=beds>0?Math.round(avail/beds*100):0;
    sevBar.innerHTML=`<div style="display:flex;align-items:center;gap:12px;font-size:12px;color:var(--muted)"><div style="flex:1;height:8px;border-radius:4px;overflow:hidden;display:flex;background:var(--border)"><div style="width:${accessPct}%;background:#10b981" title="${avail} accessible beds"></div><div style="width:${100-accessPct}%;background:var(--bad)" title="${blocked} blocked by barriers"></div></div><span><strong style="color:#10b981">${avail}</strong> accessible · <strong style="color:var(--bad)">${blocked}</strong> blocked · ${beds} total emergency beds${asof}</span></div>`;

    // ── Shelter utilization chart — horizontal bars sorted by utilization % ──
    // Filter to resources that have bed data (shelter-inventory records)
    const shelters=S.resources.filter(r=>{const bo=r.attrs?.["Beds Online"];return typeof bo==="number"&&bo>0});
    if(typeof Chart!=="undefined"&&shelters.length&&!window._dashChartDone){
      const wrap=$("#dash-chart-wrap");const cvs=document.getElementById("ch-dash");
      if(wrap&&cvs){
        wrap.style.display="block";
        shelters.sort((a,b)=>(b.attrs?.["Utilization Rate"]||0)-(a.attrs?.["Utilization Rate"]||0));
        const labels=shelters.map(s=>s.name);
        const data=shelters.map(s=>Math.round((s.attrs?.["Utilization Rate"]||0)*100));
        const colorForUtil=u=>u>=95?"#ef4444":u>=85?"#f59e0b":u>=70?"#06b6d4":"#10b981";
        const bgColors=data.map(u=>colorForUtil(u)+"88");
        const bdColors=data.map(u=>colorForUtil(u));
        // Height on WRAPPER, not canvas — Chart.js responsive mode sizes canvas to container
        wrap.style.height=Math.max(300,shelters.length*48)+"px";
        wrap.style.overflowY="auto";
        $("#dash-chart-title").textContent="Shelter Utilization — Sorted by Capacity Pressure";
        new Chart(cvs,{type:"bar",
          data:{labels,datasets:[{label:"Utilization %",data,backgroundColor:bgColors,borderColor:bdColors,borderWidth:1,borderRadius:4,barThickness:20}]},
          options:{indexAxis:"y",responsive:true,maintainAspectRatio:false,
            onClick:function(e,elements,chart){
              if(!elements.length)return;
              const name=chart.data.labels[elements[0].index];
              const q=name.split(" ").slice(0,3).join(" ");
              switchToTab("finder");const si=document.getElementById("q");if(si){si.value=q;upd({q})}
            },
            plugins:{legend:{display:false},
              tooltip:{backgroundColor:"rgba(0,0,0,.85)",titleColor:"#fff",bodyColor:"#ddd",borderColor:"rgba(255,255,255,.1)",borderWidth:1,
                callbacks:{label:function(ctx){
                  const idx=ctx.dataIndex;const s=shelters[idx];
                  const bo=s.attrs?.["Beds Online"]||0;const bu=s.attrs?.["Beds In Use"]||0;
                  const lb=s.attrs?.["Low Barrier Access"];
                  return[`Utilization: ${ctx.formattedValue}%`,`Beds: ${bu} / ${bo}`,lb===true?"✓ Low barrier access":lb===false?"✗ Restricted access":""].filter(Boolean)}}}},
            scales:{
              x:{beginAtZero:true,max:100,ticks:{color:"rgba(255,255,255,.5)",padding:8,font:{size:11},callback:v=>v+"%"},grid:{color:"rgba(255,255,255,.05)"}},
              y:{ticks:{color:"rgba(255,255,255,.7)",padding:6,font:{size:11}},grid:{display:false}}
            }
          }
        });
        window._dashChartDone=true;
      }
    }

    // ── Foster youth trajectory — HTML/CSS stepped timeline ──
    // B2: the title of the block this redraws (#zip-grid's), not the page's first .sec-title — that was the curveball block's heading in
    // Block 2 (P0.7 put it first) and is the Get Help tab's now
    const _zgp=$("#zip-grid")&&$("#zip-grid").previousElementSibling;
    const secTitle=_zgp&&_zgp.classList.contains("sec-title")?_zgp:null;
    if(secTitle)secTitle.innerHTML='Foster Youth Homelessness Trajectory<span class="ai-tag">⚡ Data-driven</span> — <em style="font-weight:400;color:var(--muted)">risk escalates after aging out of care</em>';
    const zg=$("#zip-grid");
    zg.innerHTML=`<div class="youth-timeline"><div class="youth-step"><div class="yt-age">Age 17</div><div class="yt-stat" style="color:#f59e0b">${fosterAge17}%</div><div class="yt-label">In foster care</div></div><div class="yt-arrow">→ <span class="yt-delta">+${fosterAge19-fosterAge17}pp</span></div><div class="youth-step"><div class="yt-age">Age 19</div><div class="yt-stat" style="color:#ef8c44">${fosterAge19}%</div><div class="yt-label">After partial exits</div></div><div class="yt-arrow">→ <span class="yt-delta">+${fosterAge21-fosterAge19}pp</span></div><div class="youth-step"><div class="yt-age">Age 21</div><div class="yt-stat" style="color:#ef4444">${fosterAge21}%</div><div class="yt-label">Post aging-out</div></div></div><div class="yt-narrative">Youth aging out of foster care face sharply rising homelessness risk. Without intervention, ${fosterAge21}% are homeless by 21.${typeof snap.kansasYouthAgingOutAnnual==="number"?` Kansas discharges <strong>${snap.kansasYouthAgingOutAnnual.toLocaleString("en-US")}</strong> youth from care annually.`:""}</div>`;

    // ── Crisis events (with system-alert support) ──
    const ev=$("#events");
    if(S.crisisEvents.length){
      const sorted=[...S.crisisEvents].sort((a,b)=>{
        const to={closure:0,alert:1,"system-alert":1,displacement:2,"er-overcrowding":3,supply:4,"311":5};
        return(to[a.type]??6)-(to[b.type]??6)||(b.count||b.impact||0)-(a.count||a.impact||0)});
      const top6=sorted.slice(0,6);
      const _pv=s=>typeof s==="string"&&s.includes("_")?s.replace(/_/g," ").replace(/\b\w/g,c=>c.toUpperCase()):s;
      const renderEvt=e=>{const t=e.type||"alert";
        const dot=t==="closure"?"closure":(t==="system-alert"||t==="alert")?"sysalert":t==="supply"?"supply":t==="displacement"?"closure":"call";
        let title="",meta="";
        if(t==="alert"){[title,meta]=alertText(e)}
        else if(t==="system-alert"){title=`⚠ ${e.name||"System Alert"}`;const parts=[];if(e.date)parts.push(e.date);if(e.detail)parts.push(e.detail.length>120?e.detail.slice(0,117)+"…":e.detail);if(e.category)parts.push("Affects: "+e.category);meta=parts.join(" · ")}
        else if(t==="closure"){title=`Closure: ${e.name||"?"}`;const parts=[];if(e.zip)parts.push(`ZIP ${e.zip}`);if(e.date)parts.push(e.date);if(e.impact)parts.push(e.impact.toLocaleString("en-US")+" residents affected");meta=parts.join(" · ")}
        else if(t==="displacement"){title=`Displacement: ${_pv(e.name||"?")}`;meta=`${(e.count||0).toLocaleString("en-US")} patients · ${_pv(e.category)||""}`}
        else{title=_pv(e.name||e.type||"Event");meta=e.detail||e.description||""}
        return`<div class="event"><div class="dot ${dot}"></div><div class="ev-body"><div class="ev-title">${esc(title)}</div><div class="ev-meta">${esc(meta)}</div></div></div>`};
      ev.innerHTML=top6.map(renderEvt).join("");
    }else{ev.innerHTML='<div class="state"><div class="b">No crisis events detected</div></div>'}

    return; // Skip geographic-severity dashboard below
  }

  // ══ GEOGRAPHIC-SEVERITY MODE — per-ZIP demographic dashboard (KC, Chicago) ══
  const open=S.resources.filter(r=>r.status!=="closed").length;
  const closedN=S.resources.filter(r=>r.status==="closed").length;
  const nClosures=S.crisisEvents.filter(e=>e.type==="closure").length;
  const displaced=S.crisisEvents.filter(e=>e.type==="closure").reduce((s,e)=>s+(Number(e.impact)||0),0);   // IC-5 (D2 g): a count

  // Primary metric for severity scoring (values already pre-converted by harness)
  const pf=S.chartFields[0]?.key||null;
  const _prim=z=>pf?(z[pf]||0):0;

  // Relative severity: sort by primary metric, top 1/3 = HIGH, mid = MED, bottom = LOW
  let sevThreshHigh=35, sevThreshMed=25;
  if(pf&&S.zipStats.length>=3){
    const vals=[...S.zipStats].map(z=>_prim(z)).sort((a,b)=>b-a);
    sevThreshHigh=vals[Math.floor(vals.length*0.33)]||vals[0]*0.8;
    sevThreshMed=vals[Math.floor(vals.length*0.66)]||vals[0]*0.5;
  }
  const _sev=v=>v>sevThreshHigh?"high":v>sevThreshMed?"med":"low";

  const highZips=S.zipStats.filter(z=>_sev(_prim(z))==="high").length;
  const worstZip=S.zipStats.length?[...S.zipStats].sort((a,b)=>_prim(b)-_prim(a))[0]:null;
  const worstVal=worstZip?Math.round(_prim(worstZip)*10)/10:0;
  const worstCode=worstZip?(worstZip.zip||worstZip.Zip||"?"):"?";
  const pfLabel=S.chartFields[0]?.label||"Risk";
  const pfUnit=S.chartFields[0]?.unit||"";
  // Suppress unit when label already contains it (prevents "No Vehicle % (%)" redundancy)
  const pfUnitDisplay=pfUnit&&!pfLabel.includes(pfUnit)?pfUnit:"";
  const crisisNoun=S.domainHints?.crisis_noun||"closures";
  const unitsCap=String(S.domainHints?.units||"residents").replace(/\b\w/g,c=>c.toUpperCase());   // BUILD B3 (D13, §9): the brief's unit
  const al=S.areaLabel||"ZIP";

  // Hero crisis statement — P0.7 (D6): only the announcement's closures are the curveball's; a closure in the data is named as the data's
  const hero=$("#hero-crisis");
  const closedNames=S.resources.filter(r=>r.status==="closed"&&r.closed_by==="announcement").map(r=>r.name);
  const dataClosedN=S.resources.filter(r=>r.status==="closed"&&r.closed_by!=="announcement").length;
  let heroExtra="";
  if(closedNames.length>0){heroExtra=` <span style="color:var(--warn)">⚡ +${closedNames.length} resource${closedNames.length>1?"s":""} closed by curveball</span>`}
  if(dataClosedN>0){heroExtra+=` <span style="color:var(--muted)">· ${dataClosedN} closed per the data</span>`}
  if(displaced>0){
    hero.innerHTML=`<span style="color:var(--bad)">${nClosures} ${esc(crisisNoun.replace(/\b\w/g,c=>c.toUpperCase()))}</span> ${nClosures!==1?"Have":"Has"} Displaced <span style="color:var(--bad)">${displaced.toLocaleString("en-US")} ${esc(unitsCap)}</span> — ${esc(al)} ${esc(worstCode)} Faces <span style="color:var(--bad)">${worstVal}${esc(pfUnitDisplay)}</span> ${esc(pfLabel)}${heroExtra}`;
  }else if(S.resources.length>0){
    hero.innerHTML=`<span style="color:var(--accent)">${S.resources.length} resources</span> across <span style="color:var(--accent)">${Object.keys(S.zips).length} ${esc(al)} codes</span> — ${highZips} areas at elevated risk${heroExtra}`;
  }else{hero.style.display="none"}

  // KPIs with domain-adaptive text — P0.6 (D7): the signal kinds are the ones this data holds, never a fixed list
  const sigWords={"closure":crisisNoun,"alert":"alerts","system-alert":"alerts","supply":"alerts","311":"311 calls","displacement":"displacement records","er-overcrowding":"ER overcrowding"};
  const sigKinds=[...new Set(S.crisisEvents.map(e=>sigWords[e.type]||String(e.type||"events")))];
  const sigSub=sigKinds.length?esc(sigKinds.join(", ").replace(/^\w/,c=>c.toUpperCase())):"No signals in the data";
  const kpis=[
    {label:`Displaced ${esc(unitsCap)}`,num:displaced,fmt:n=>n.toLocaleString("en-US"),sub:`${nClosures} ${esc(crisisNoun)} detected`,cls:"red"},
    {label:"Resources Available",num:open,fmt:n=>String(n),sub:`${S.resources.length} total${closedN?` (${[dataClosedN?dataClosedN+" closed per the data":"",closedNames.length?closedNames.length+" closed by the curveball":""].filter(Boolean).join(", ")})`:""}`,cls:"green"},
    {label:`High-Need ${esc(al)}s`,num:highZips,fmt:n=>String(n),sub:`${esc(pfLabel)} elevated · Worst: ${esc(worstCode)} (${worstVal}${esc(pfUnitDisplay)})`,cls:"amber"},
    {label:"Crisis Signals",num:S.crisisEvents.length,fmt:n=>String(n),sub:sigSub,cls:"purple"},  // P0.6 (D7): the exact count; the kinds the data holds
  ];
  if(closedNames.length>0){const un=[...new Set(closedNames)];const names=un.slice(0,2).join(", ")+(un.length>2?" +more":"");kpis.push({label:"⚠ Curveball Impact",num:closedNames.length,fmt:n=>String(n),sub:esc(names)||"Resources closed by the announcement",cls:"red"})}
  
  $("#kpi-bar").innerHTML=kpis.map((k,i)=>`<div class="kpi ${k.cls}"><div class="label">${k.label}</div><div class="val" data-target="${k.num}" data-idx="${i}">0</div><div class="sub">${k.sub}</div></div>`).join("");
  setTimeout(()=>{$$(".kpi .val[data-target]").forEach(el=>{
    const target=parseInt(el.dataset.target)||0;const idx=parseInt(el.dataset.idx)||0;
    const fmt=kpis[idx]?.fmt||(n=>String(n));
    if(target===0){el.textContent=fmt(0);return}
    const dur=600;const t0=performance.now();
    function step(t){const p=Math.min(1,(t-t0)/dur);const ease=1-Math.pow(1-p,3);
      el.textContent=fmt(Math.round(target*ease));
      if(p<1)requestAnimationFrame(step)}
    requestAnimationFrame(step)})},50);

  // Severity distribution bar
  const sevBar=$("#sev-bar");
  if(S.zipStats.length){
    const hi=S.zipStats.filter(z=>_sev(_prim(z))==="high").length;
    const med=S.zipStats.filter(z=>_sev(_prim(z))==="med").length;
    const lo=S.zipStats.length-hi-med;
    const totalPop=S.zipStats.reduce((s,z)=>s+_getNum(z,['population','Population']),0);
    const tot=S.zipStats.length;
    sevBar.innerHTML=`<div style="display:flex;align-items:center;gap:12px;font-size:12px;color:var(--muted)"><div style="flex:1;height:8px;border-radius:4px;overflow:hidden;display:flex;background:var(--border)">${hi?`<div style="width:${(hi/tot*100).toFixed(0)}%;background:var(--bad)" title="${hi} HIGH severity"></div>`:""}${med?`<div style="width:${(med/tot*100).toFixed(0)}%;background:var(--warn)" title="${med} MED severity"></div>`:""}${lo?`<div style="width:${(lo/tot*100).toFixed(0)}%;background:#22c55e" title="${lo} LOW severity"></div>`:""}</div><span><strong style="color:var(--bad)">${hi}</strong> HIGH · <strong style="color:var(--warn)">${med}</strong> MED · <strong style="color:#22c55e">${lo}</strong> LOW · ${totalPop.toLocaleString("en-US")} residents</span></div>`;
  }

  // Dashboard horizontal bar chart — primary metric by area, color-coded by severity
  if(typeof Chart!=="undefined"&&S.zipStats.length&&pf&&!window._dashChartDone){
    const wrap=$("#dash-chart-wrap");
    const cvs=document.getElementById("ch-dash");
    if(wrap&&cvs){
      wrap.style.display="block";
      const sorted=[...S.zipStats].sort((a,b)=>_prim(b)-_prim(a));
      const labels=sorted.map(z=>al+" "+(z.zip||z.Zip||"?"));
      const data=sorted.map(z=>Math.round(_prim(z)*10)/10);
      const bgColors=sorted.map(z=>{
        const s=_sev(_prim(z));
        return s==="high"?"rgba(239,68,68,.55)":s==="med"?"rgba(245,158,11,.55)":"rgba(34,197,94,.55)";
      });
      const bdColors=sorted.map(z=>{
        const s=_sev(_prim(z));
        return s==="high"?"#ef4444":s==="med"?"#f59e0b":"#22c55e";
      });
      const unitSuffix=S.chartFields[0]?.unit&&!pfLabel.includes(S.chartFields[0].unit)?" ("+S.chartFields[0].unit+")":"";
      $("#dash-chart-title").textContent=pfLabel+unitSuffix+" by "+al;
      new Chart(cvs,{type:"bar",
        data:{labels,datasets:[{label:pfLabel,data,backgroundColor:bgColors,borderColor:bdColors,borderWidth:1,borderRadius:4}]},
        options:{indexAxis:"y",responsive:true,maintainAspectRatio:false,
          onClick:function(e,elements,chart){
            if(!elements.length)return;
            const raw=chart.data.labels[elements[0].index];
            const zip=raw.replace(/^[A-Za-z]+\s*/,"");
            if(zip)crossFilterZip(zip);
          },
          plugins:{legend:{display:false},
            tooltip:{backgroundColor:"rgba(0,0,0,.85)",titleColor:"#fff",bodyColor:"#ddd",borderColor:"rgba(255,255,255,.1)",borderWidth:1,
              callbacks:{label:function(ctx){return ctx.dataset.label+": "+ctx.formattedValue+(S.chartFields[0]?.unit||"")}}}},
          scales:{
            x:{beginAtZero:true,ticks:{color:"rgba(255,255,255,.5)",padding:8,font:{size:11}},grid:{color:"rgba(255,255,255,.05)"}},
            y:{ticks:{color:"rgba(255,255,255,.7)",padding:6,font:{size:11}},grid:{display:false}}
          }
        }
      });
      window._dashChartDone=true;
    }
  }

  // ZIP grid — dynamic stats from whatever fields exist
  const zg=$("#zip-grid");
  if(S.zipStats.length){
    const sorted=[...S.zipStats].sort((a,b)=>_prim(b)-_prim(a));
    const maxPrim=Math.max(_prim(sorted[0])||1,0.1); // guard against zero
    zg.innerHTML=sorted.map((z,i)=>{
      const zip=z.zip||z.Zip||"?";
      const sev=_sev(_prim(z));
      const pop=_getNum(z,['population','Population']);
      const sevColor=sev==='high'?'var(--bad)':sev==='med'?'var(--warn)':'var(--good)';
      let stats="";
      // Show chart fields dynamically
      for(const cf of S.chartFields){
        let val=z[cf.key]||0;
        if(typeof val==="number")val=Math.round(val*10)/10; // round for display
        if(val)stats+=`<div class="st"><span>${esc(cf.label)}</span><span class="sv" style="color:${sev==='high'?'var(--bad)':sev==='med'?'var(--warn)':'var(--text)'}">${esc(val)}${esc(cf.unit)}</span></div>`;
      }
      if(pop)stats+=`<div class="st"><span>Population</span><span class="sv">${pop.toLocaleString("en-US")}</span></div>`;
      // Progress bar — width proportional to primary metric vs dataset max
      const pct=pf?Math.round((_prim(z)/maxPrim)*100):0;
      const bar=pct?`<div style="height:4px;border-radius:2px;background:var(--border);margin:8px 0 4px;overflow:hidden"><div style="width:${pct}%;height:100%;border-radius:2px;background:${sevColor};transition:width .4s ease"></div></div>`:"";
      return`<div class="zip-card sev-${sev}" data-zip="${esc(zip)}" style="animation:fadeSlide .3s ease both;animation-delay:${i*40}ms"><div class="zc">${esc(al)} ${esc(zip)} <span class="sev ${sev}">${sev.toUpperCase()}</span></div>${stats}${bar}<div class="hint">Click to find resources →</div></div>`;
    }).join("")}
  else{zg.innerHTML='<div class="state"><div class="b">No demographic data available</div></div>'}
  // Fix 9: Pulse curveball-affected ZIP cards — P0.7 (D6): the announcement's closures only
  const closedZips=new Set(S.resources.filter(r=>r.status==="closed"&&r.closed_by==="announcement").map(r=>r.location?.zip).filter(Boolean));
  if(closedZips.size>0){zg.querySelectorAll(".zip-card").forEach(c=>{if(closedZips.has(c.dataset.zip))c.classList.add("curveball-hit")})}

  // Crisis events — capped, priority sorted
  const ev=$("#events");
  if(S.crisisEvents.length){
    const sorted=[...S.crisisEvents].sort((a,b)=>{
      const to={closure:0,alert:1,displacement:2,"er-overcrowding":3,supply:4,"311":5};
      return(to[a.type]??6)-(to[b.type]??6)||(b.count||b.impact||0)-(a.count||a.impact||0)});
    const top6=sorted.slice(0,6);
    const _pv=s=>typeof s==="string"&&s.includes("_")?s.replace(/_/g," ").replace(/\b\w/g,c=>c.toUpperCase()):s;
    const al=S.areaLabel||"ZIP";
    const renderEvt=e=>{const t=e.type||"alert";const dot=t==="closure"?"closure":t==="alert"?"sysalert":t==="supply"?"supply":t==="displacement"?"closure":t==="er-overcrowding"?"closure":"call";
      let title="",meta="";
      if(t==="alert"){[title,meta]=alertText(e)}
      else if(t==="closure"){title=`Closure: ${e.name||"?"}`;const parts=[];if(e.zip)parts.push(`${al} ${e.zip}`);if(e.date)parts.push(e.date);if(e.impact)parts.push(e.impact.toLocaleString("en-US")+" residents affected");meta=parts.join(" · ")}
      else if(t==="displacement"){title=`Displacement: ${_pv(e.name||"?")}`;meta=`${(e.count||0).toLocaleString("en-US")} patients · ${_pv(e.category)||""}`}
      else if(t==="er-overcrowding"){title=`ER Overcrowding: ${_pv(e.name||"?")}`;meta=`${al} ${e.zip||"?"} · ${_pv(e.category)||""}`}
      else if(t==="311"){title=`311 Distress: ${al} ${e.zip||"?"}`;meta=`${e.count||0} calls · ${_pv(e.category)||""}`}
      else if(t==="supply"){title=`Supply Alert: ${e.severity||""}`;meta=`${e.description||""}`}
      else{title=_pv(e.type||"Event");meta=""}
      return`<div class="event" data-zip="${esc(e.zip||"")}"><div class="dot ${dot}"></div><div class="ev-body"><div class="ev-title">${esc(title)}</div><div class="ev-meta">${esc(meta)}</div></div></div>`};
    ev.innerHTML=top6.map(renderEvt).join("");
    if(sorted.length>6){
      const rest=sorted.slice(6);
      const moreId="ev-more-"+Date.now();
      ev.innerHTML+=`<div id="${moreId}" style="display:none">${rest.map(renderEvt).join("")}</div>`;
      ev.innerHTML+=`<div style="text-align:center;padding:8px"><button onclick="const m=document.getElementById('${moreId}');const b=this;if(m.style.display==='none'){m.style.display='block';b.textContent='Show fewer'}else{m.style.display='none';b.textContent='Show all ${sorted.length-6} remaining events'}" style="background:none;border:1px solid var(--border);color:var(--accent);padding:6px 16px;border-radius:8px;cursor:pointer;font-size:12px">Show all ${sorted.length-6} remaining events</button></div>`}}
  else{ev.innerHTML='<div class="state"><div class="b">No crisis events detected</div></div>'}
}

// Helper: get numeric value from ZIP stat by trying multiple key names
function _getNum(obj,keys){for(const k of keys){const v=obj[k];if(typeof v==="number")return v}return 0}

// ── Render: Charts (Excellence Report §4: dark-theme config) ─────────────
function renderCharts(){
  if(typeof Chart==="undefined"){$$(".chart-box").forEach(b=>{b.innerHTML="<p style='color:var(--muted);font-size:13px;padding:20px'>Charts unavailable — Chart.js didn't load.</p>"});return}
  const zs=S.zipStats;
  const pf=S.chartFields[0]?.key||null;
  const al=S.areaLabel||"ZIP";

  // ── ZipStats-dependent charts (only render if demographics data exists) ──
  if(zs.length){
  const sorted=pf?[...zs].sort((a,b)=>(b[pf]||0)-(a[pf]||0)):[...zs];
  const labels=sorted.map(z=>z.zip||z.Zip||"?");

  // Dark-theme chart config with cross-filtering
  const darkOpts=(label,unit)=>({responsive:true,maintainAspectRatio:false,
    layout:{padding:{left:8,top:4}},
    onClick:(e,elements,chart)=>{
      if(!elements.length)return;
      const zip=chart.data.labels[elements[0].index];
      if(zip)crossFilterZip(zip);
    },
    plugins:{legend:{display:false},
      tooltip:{backgroundColor:"rgba(0,0,0,.85)",titleColor:"#fff",bodyColor:"#ddd",borderColor:"rgba(255,255,255,.1)",borderWidth:1,
        callbacks:{label:ctx=>ctx.dataset.label+": "+ctx.formattedValue+(unit||"")}}},
    scales:{y:{beginAtZero:true,ticks:{color:"rgba(255,255,255,.5)",padding:8,font:{size:11}},grid:{color:"rgba(255,255,255,.05)"}},
      x:{ticks:{color:"rgba(255,255,255,.5)",padding:6,font:{size:11},maxRotation:45},grid:{display:false}}}});

  // Dynamic bar charts from chartFields (values pre-converted by harness)
  const barColors=["#ef4444","#f59e0b","#8b5cf6","#06b6d4","#22c55e"];
  const row1=document.getElementById("dynamic-charts-row1");
  const extraBox=document.getElementById("dynamic-chart-extra");
  const fields=S.chartFields.slice(0,3);
  fields.forEach((cf,i)=>{
    const container=i<2?row1:extraBox;
    if(!container)return;
    const box=document.createElement("div");
    if(i<2)box.className="chart-box";
    const canvasId="ch-dyn-"+i;
    const unitSuffix=cf.unit&&!cf.label.includes(cf.unit)?' ('+esc(cf.unit)+')':'';
    box.innerHTML=`<h3>${esc(cf.label)}${unitSuffix}</h3><canvas id="${canvasId}" aria-label="${esc(cf.label)} bar chart"></canvas><div class="chart-hint">Click a bar to explore that ${esc(al)}</div>`;
    container.appendChild(box);
    const ctx=document.getElementById(canvasId);
    if(!ctx)return;
    const data=sorted.map(z=>z[cf.key]||0);
    new Chart(ctx,{type:"bar",data:{labels,datasets:[{label:cf.label,data,backgroundColor:barColors[i%barColors.length]+"55",borderColor:barColors[i%barColors.length],borderWidth:1,borderRadius:4,hoverBackgroundColor:barColors[i%barColors.length]+"99"}]},options:darkOpts(cf.label,cf.unit)});
  });
  // If no chart fields, show message
  if(!fields.length&&row1){row1.innerHTML='<div class="chart-box"><p style="color:var(--muted);padding:20px">No numeric demographic fields found for chart visualization.</p></div>'}
  } else {
    // No zipStats — render system metrics reference table from community-snapshot data
    const row1=document.getElementById("dynamic-charts-row1");
    const snap=S.systemSnapshot||{};
    if(row1&&snap.shelteredAndUnshelteredTotal){
      // Curated metric definitions grouped by category
      const groups=[
        {name:"Population",items:[
          {label:"Total Experiencing Homelessness",key:"shelteredAndUnshelteredTotal",fmt:"int"},
          {label:"Currently Sheltered / Transitional",key:"shelteredOrTransitional",fmt:"int"},
          {label:"Currently Unsheltered",key:"unshelteredHeadcount",fmt:"int"},
          {label:"First-Time Homeless (Annual)",key:"firstTimeHomelessAnnual",fmt:"int"},
          {label:"People Served Annually",key:"peopleServedAnnual",fmt:"int"},
        ]},
        {name:"System Capacity",items:[
          {label:"Emergency Shelter Beds",key:"totalEmergencyBeds",fmt:"int"},
          {label:"Beds Available",key:"bedsAvailableNow",fmt:"int"},
          {label:"Per Capita Rate",key:"perCapitaRateLocal",fmt:"int",cmp:"perCapitaRateNational",cmpLabel:"national"},
        ]},
        {name:"Foster Youth",items:[
          {label:"Homelessness Rate — Age 17",key:"fosterHomelessnessAge17",fmt:"pct"},
          {label:"Homelessness Rate — Age 19",key:"fosterHomelessnessAge19",fmt:"pct"},
          {label:"Homelessness Rate — Age 21",key:"fosterHomelessnessAge21",fmt:"pct"},
          {label:"Kansas Youth Aging Out Annually",key:"kansasYouthAgingOutAnnual",fmt:"int"},
        ]},
        {name:"Performance",items:[
          {label:"Average Days to Housing",key:"avgDaysToHousing",fmt:"days",cmp:"nationalDaysToHousing",cmpLabel:"national avg"},
          {label:"Housed Within One Year",key:"housedWithinYearRate",fmt:"pct"},
          {label:"2-Year Permanent Housing Retention",key:"permanentRetention2yr",fmt:"pct"},
          {label:"VASH Placements (Annual)",key:"vashPlacementsAnnual",fmt:"int"},
        ]},
        {name:"System Scale",items:[
          {label:"Coalition Member Organizations",key:"coalitionMemberOrgs",fmt:"int"},
          {label:"Newly Homeless Share of Served",key:"newlyHomelessShare",fmt:"pct"},
        ]},
      ];
      // Format a value based on type
      const fmtVal=(v,fmt)=>{
        if(v===undefined||v===null)return"—";
        if(fmt==="pct")return Math.round(v*100)+"%";
        if(fmt==="days")return v+" days";
        if(fmt==="int")return typeof v==="number"?v.toLocaleString("en-US"):String(v);
        return String(v);
      };
      let h='<div class="chart-box" style="grid-column:1/-1"><h3>System Metrics — Community Snapshot</h3>'+(S.snapshotAsof?`<p style="font-size:11px;color:var(--muted);font-style:italic;margin:-4px 0 8px">${esc(S.snapshotAsof)}</p>`:"");
      h+='<table class="ds-tbl" style="font-variant-numeric:tabular-nums">';
      for(const g of groups){
        // Section header row
        h+=`<tr><td colspan="2" style="padding:14px 10px 5px;font-size:12px;font-weight:700;color:rgba(255,255,255,0.35);text-transform:uppercase;letter-spacing:0.08em;border-bottom:1px solid rgba(255,255,255,0.07)">${esc(g.name)}</td></tr>`;
        for(const m of g.items){
          const v=snap[m.key];
          const displayed=fmtVal(v,m.fmt);
          // Inline comparison annotation if defined
          let annotation="";
          if(m.cmp&&snap[m.cmp]!==undefined){
            const cmpVal=fmtVal(snap[m.cmp],m.fmt);
            annotation=` <span style="font-size:0.78em;color:rgba(255,255,255,0.4);margin-left:6px">vs ${esc(cmpVal)} ${m.cmpLabel||""}</span>`;
          }
          h+=`<tr><td style="padding:7px 10px;color:rgba(255,255,255,0.65)">${esc(m.label)}</td><td style="padding:7px 10px;text-align:right;color:rgba(255,255,255,0.92);font-weight:600">${esc(displayed)}${annotation}</td></tr>`;
        }
      }
      h+='</table></div>';
      row1.innerHTML=h;
    } else if(row1){
      row1.innerHTML='<div class="chart-box"><p style="color:var(--muted);padding:20px">This dataset uses system-level aggregate metrics rather than per-area demographics. See the Dashboard tab for system capacity analysis.</p></div>';
    }
  }
  
  // Priority 2: Doughnut center text plugin — shows total in the hole
  const centerTextPlugin={id:"centerText",
    beforeDatasetsDraw(chart){
      const{ctx}=chart;
      const meta=chart.getDatasetMeta(0);if(!meta.data.length)return;
      const x=meta.data[0].x,y=meta.data[0].y;
      const total=chart.data.datasets[0].data.reduce((a,b)=>a+b,0);
      ctx.save();
      ctx.font="bold 30px system-ui";ctx.fillStyle="rgba(255,255,255,.88)";
      ctx.textAlign="center";ctx.textBaseline="middle";
      ctx.fillText(total,x,y-8);
      ctx.font="13px system-ui";ctx.fillStyle="rgba(255,255,255,.45)";
      ctx.fillText("resources",x,y+14);
      ctx.restore()}};

  const cc={};S.resources.forEach(r=>{const c=r.category||"Other";cc[c]=(cc[c]||0)+1});
  const cl=Object.keys(cc),cv=Object.values(cc);
  const cols=["#8b5cf6","#22c55e","#ef4444","#f59e0b","#06b6d4","#ec4899","#84cc16"];
  const cctx=document.getElementById("ch-cats");
  if(cctx){new Chart(cctx,{type:"doughnut",
    data:{labels:cl,datasets:[{data:cv,backgroundColor:cols.slice(0,cl.length),hoverOffset:8}]},
    options:{responsive:true,maintainAspectRatio:false,cutout:"62%",
      // Priority 3: Tooltip showing count + percentage
      plugins:{legend:{position:"bottom",labels:{color:"rgba(255,255,255,.7)",font:{size:13},padding:12}},
        tooltip:{backgroundColor:"rgba(0,0,0,.85)",titleColor:"#fff",bodyColor:"#ddd",
          callbacks:{label:ctx=>{
            const total=ctx.dataset.data.reduce((a,b)=>a+b,0);
            const pct=((ctx.parsed/total)*100).toFixed(0);
            return ctx.parsed+" resource"+(ctx.parsed!==1?"s":"")+" ("+pct+"%)"}}}}},
    plugins:[centerTextPlugin]})}

  // ── Access Barriers Panel — fills empty left box when system-snapshot mode ──
  if(!zs.length&&S.resources.length){
    const extraBox=document.getElementById("dynamic-chart-extra");
    if(extraBox){
      // Filter to shelter resources that have bed data
      const shelters=S.resources.filter(r=>{const bo=r.attrs?.["Beds Online"];return typeof bo==="number"});
      const shelterCount=shelters.length;
      if(shelterCount>0){
        const lowBarrier=shelters.filter(r=>r.attrs?.["Low Barrier Access"]===true).length;
        const referralReq=shelters.filter(r=>r.attrs?.["Requires Referral"]===true).length;
        // Count by service audience
        const audiences={};
        shelters.forEach(r=>{const sa=r.attrs?.["Service Audience"]||"Unknown";audiences[sa]=(audiences[sa]||0)+1});
        const audienceLines=Object.entries(audiences).sort((a,b)=>b[1]-a[1]).map(([k,v])=>`<tr><td style="padding:5px 10px;color:rgba(255,255,255,0.65)">${esc(k)}</td><td style="padding:5px 10px;text-align:right;color:rgba(255,255,255,0.92);font-weight:600">${Number(v)}</td></tr>`).join("");
        let bp='<h3>Access Profile — Shelters</h3>';
        bp+='<table class="ds-tbl" style="font-variant-numeric:tabular-nums">';
        bp+=`<tr><td colspan="2" style="padding:12px 10px 5px;font-size:12px;font-weight:700;color:rgba(255,255,255,0.35);text-transform:uppercase;letter-spacing:0.08em;border-bottom:1px solid rgba(255,255,255,0.07)">Accessibility</td></tr>`;
        bp+=`<tr><td style="padding:7px 10px;color:rgba(255,255,255,0.65)">Low-barrier access</td><td style="padding:7px 10px;text-align:right;color:rgba(255,255,255,0.92);font-weight:600">${lowBarrier} of ${shelterCount}</td></tr>`;
        bp+=`<tr><td style="padding:7px 10px;color:rgba(255,255,255,0.65)">Referral required</td><td style="padding:7px 10px;text-align:right;color:rgba(255,255,255,0.92);font-weight:600">${referralReq} of ${shelterCount}</td></tr>`;
        bp+=`<tr><td style="padding:7px 10px;color:rgba(255,255,255,0.65)">Walk-in / self-referral</td><td style="padding:7px 10px;text-align:right;color:rgba(255,255,255,0.92);font-weight:600">${shelterCount-referralReq} of ${shelterCount}</td></tr>`;
        bp+=`<tr><td colspan="2" style="padding:12px 10px 5px;font-size:12px;font-weight:700;color:rgba(255,255,255,0.35);text-transform:uppercase;letter-spacing:0.08em;border-bottom:1px solid rgba(255,255,255,0.07)">Population Served</td></tr>`;
        bp+=audienceLines;
        bp+='</table>';
        extraBox.innerHTML=bp;
      }
    }
  }

  // Render the sortable table (separate function to avoid chart duplication on sort)
  renderZipTable();

  // ── Resource inventory table — when no zipStats but resources exist ──
  if(!zs.length&&S.resources.length){renderResourceInventory()}
}

// ── Sortable ZIP stats table (standalone — called from renderCharts and sort handlers) ──
function renderZipTable(){
  const ztWrap=document.getElementById("zip-tbl-wrap");
  const zs=S.zipStats;
  const al=S.areaLabel||"ZIP";
  if(!ztWrap||!zs.length||!S.chartFields.length)return;
  ztWrap.style.display="block";
  // Sort state (persists across re-renders)
  if(!window._ztSort){window._ztSort={col:S.chartFields[0]?.key||"",asc:false}}
  const st=window._ztSort;
  // Build columns: ZIP + chartFields + Population
  const cols=[{key:"_zip",label:al,unit:"",isNum:false}];
  for(const cf of S.chartFields)cols.push({key:cf.key,label:cf.label,unit:cf.unit||"",isNum:true});
  cols.push({key:"_pop",label:"Population",unit:"",isNum:true});
  // Sort data
  const rows=[...zs].sort((a,b)=>{
    let av,bv;
    if(st.col==="_zip"){av=a.zip||a.Zip||"";bv=b.zip||b.Zip||""}
    else if(st.col==="_pop"){av=_getNum(a,["population","Population"]);bv=_getNum(b,["population","Population"])}
    else{av=a[st.col]||0;bv=b[st.col]||0}
    if(typeof av==="number"&&typeof bv==="number")return st.asc?av-bv:bv-av;
    return st.asc?String(av).localeCompare(String(bv)):String(bv).localeCompare(String(av));
  });
  // Column widths: ZIP gets 16%, numeric columns split the remaining 84% equally
  const numCols=cols.length-1; // all columns except ZIP
  const numPct=(84/numCols).toFixed(1);
  // Render — includes <colgroup> for explicit width control (per CSS 2.1 fixed table algorithm)
  let h='<h3 style="font-size:14px;font-weight:700;margin:0 0 8px">Area Statistics</h3>';
  h+='<div style="overflow-x:auto;-webkit-overflow-scrolling:touch"><table class="zip-tbl">';
  // colgroup — explicit widths prevent equal-distribution fallback
  h+='<colgroup><col style="width:16%">';
  for(let i=0;i<numCols;i++)h+=`<col style="width:${numPct}%">`;
  h+='</colgroup>';
  // thead — headers get .text/.num classes matching their data cells
  h+='<thead><tr>';
  for(const c of cols){
    const isSorted=st.col===c.key;
    const arrow=isSorted?(st.asc?"▲":"▼"):"▼";
    const cls=(c.isNum?"num":"text")+(isSorted?" sorted":"");
    h+=`<th class="${cls}" scope="col" data-zt-col="${esc(c.key)}">${esc(c.label)}${c.unit&&!c.label.includes(c.unit)?" ("+esc(c.unit)+")":""}<span class="arr">${arrow}</span></th>`;
  }
  h+='</tr></thead><tbody>';
  // tbody — ZIP cells get .text, numeric cells get .num
  for(const z of rows){
    const zip=z.zip||z.Zip||"?";
    const pop=_getNum(z,["population","Population"]);
    h+=`<tr data-zt-zip="${esc(zip)}"><td class="text">${esc(al)} ${esc(zip)}</td>`;
    for(const cf of S.chartFields){
      let v=z[cf.key]||0;if(typeof v==="number")v=Math.round(v*10)/10;
      h+=`<td class="num">${esc(v)}${esc(cf.unit||"")}</td>`;
    }
    h+=`<td class="num">${pop?pop.toLocaleString("en-US"):"—"}</td></tr>`;
  }
  h+='</tbody></table></div>';
  h+='<div style="font-size:11px;color:var(--muted);text-align:center;margin-top:6px;opacity:.6">Click a column header to sort · Click a row to explore that area</div>';
  ztWrap.innerHTML=h;
  // Attach sort handlers — calls renderZipTable() NOT renderCharts()
  ztWrap.querySelectorAll("th[data-zt-col]").forEach(th=>{
    th.addEventListener("click",function(){
      const col=this.dataset.ztCol;
      if(st.col===col){st.asc=!st.asc}else{st.col=col;st.asc=false}
      renderZipTable();
    });
  });
  // Attach row click handlers
  ztWrap.querySelectorAll("tr[data-zt-zip]").forEach(tr=>{
    tr.addEventListener("click",function(){crossFilterZip(this.dataset.ztZip)});
  });
}

// ── Resource Inventory table (standalone — for sort handler re-renders) ──
function renderResourceInventory(){
  const ztWrap=document.getElementById("zip-tbl-wrap");
  if(!ztWrap||!S.resources.length)return;
  ztWrap.style.display="block";
  if(!window._riSort)window._riSort={col:"name",asc:true};
  const rst=window._riSort;
  // Category badge colors (per research: distinct hues for visual grouping)
  const catColors={"Shelter Inventory":"#3b82f6","Intake Center":"#06b6d4","Hotline":"#8b5cf6",
    "Outreach":"#ec4899","Rehousing Options":"#f59e0b","Shelter Intake":"#10b981"};
  const catColor=c=>catColors[c]||"#8b5cf6";
  // Extract key detail per resource category
  const keyDetail=r=>{
    const a=r.attrs||{};
    const bo=a["Beds Online"],bu=a["Beds In Use"],ut=a["Utilization Rate"];
    if(typeof bo==="number"&&bo>0)return`${bu||0}/${bo} beds · ${Math.round((ut||0)*100)}%`;
    const hrs=a["Open Hours"]||a["Operating Hours"];
    if(hrs)return String(hrs);
    const units=a["Unit Count"];
    if(typeof units==="number")return`${units} units`;
    return r.category||"—";
  };
  // Sort resources
  const sorted=[...S.resources].sort((a,b)=>{
    let av,bv;
    if(rst.col==="name"){av=a.name||"";bv=b.name||""}
    else if(rst.col==="category"){av=a.category||"";bv=b.category||""}
    else{av=a.name||"";bv=b.name||""}
    return rst.asc?String(av).localeCompare(String(bv)):String(bv).localeCompare(String(av));
  });
  let h='<h3 style="font-size:14px;font-weight:700;margin:0 0 8px">Resource Inventory</h3>';
  h+='<div style="overflow-x:auto;-webkit-overflow-scrolling:touch"><table class="zip-tbl">';
  h+='<colgroup><col style="width:45%"><col style="width:22%"><col style="width:33%"></colgroup>';
  const mkTh=(col,label,cls)=>{
    const active=rst.col===col;
    const arrow=active?(rst.asc?"▲":"▼"):"▼";
    return`<th class="${cls}${active?" sorted":""}" scope="col" data-ri-col="${col}">${label}<span class="arr">${arrow}</span></th>`;
  };
  h+='<thead><tr>';
  h+=mkTh("name","Resource","text");
  h+=mkTh("category","Category","text");
  h+='<th class="num" scope="col">Key Detail</th>';
  h+='</tr></thead><tbody>';
  for(const r of sorted){
    const cc=catColor(r.category);
    const badge=`<span style="display:inline-block;padding:2px 8px;border-radius:999px;font-size:12px;font-weight:600;background:${cc}22;color:${cc};border:1px solid ${cc}44">${esc(r.category||"Other")}</span>`;
    h+=`<tr data-ri-name="${esc(r.name)}" style="cursor:pointer"><td class="text">${esc(r.name)}</td><td class="text">${badge}</td><td class="num" style="font-size:14px;color:rgba(255,255,255,0.7)">${esc(keyDetail(r))}</td></tr>`;
  }
  h+='</tbody></table></div>';
  h+='<div style="font-size:11px;color:var(--muted);text-align:center;margin-top:6px;opacity:.6">Click a row to explore that resource · Click a column header to sort</div>';
  ztWrap.innerHTML=h;
  // Sort handlers — calls renderResourceInventory() NOT renderCharts()
  ztWrap.querySelectorAll("th[data-ri-col]").forEach(th=>{
    th.addEventListener("click",function(){
      const col=this.dataset.riCol;
      if(rst.col===col){rst.asc=!rst.asc}else{rst.col=col;rst.asc=true}
      renderResourceInventory();
    });
  });
  // Row click → cross-filter to Finder
  ztWrap.querySelectorAll("tr[data-ri-name]").forEach(tr=>{
    tr.addEventListener("click",function(){
      const name=this.dataset.riName;
      const q=name.split(" ").slice(0,3).join(" ");
      switchToTab("finder");
      const si=document.getElementById("q");
      if(si){si.value=q;upd({q})}
    });
  });
}
// Clean category names: "Behavioral-Health" → "Behavioral Health", "Fqhc" → "FQHC"
function _cleanCat(s){
  const abbrs={"fqhc":"FQHC","er":"ER","icu":"ICU","ob":"OB"};
  if(abbrs[s.toLowerCase()])return abbrs[s.toLowerCase()];
  return s.replace(/-/g," ").replace(/\b\w/g,c=>c.toUpperCase());
}

function buildCatFilters(){const h=S.hints;if(!h?.categories?.length)return;const c=$("#cat-chips");c.innerHTML="";
  for(const cat of h.categories){const ch=document.createElement("label");ch.className="chip";
    ch.innerHTML=`<input type="checkbox" value="${esc(cat)}"/>${esc(_cleanCat(cat))}`;c.appendChild(ch)}}

function buildDynFilters(){const h=S.hints,c=$("#dyn-filters");if(!h)return;let html="";
  if(h.bool_filters?.length){html+='<div class="fsec"><div class="flbl">Requirements</div><div class="chips">';
    for(const bf of h.bool_filters)html+=`<label class="chip"><input type="checkbox" data-bf="${esc(bf)}"/>${esc(bf)}</label>`;html+='</div></div>'}
  for(const ek of Object.keys(h.enum_filters||{}).slice(0,3)){const vals=h.enum_filters[ek];
    html+=`<div class="fsec"><div class="flbl">${esc(ek)}</div><div class="chips">`;
    for(const v of vals)html+=`<label class="chip"><input type="checkbox" data-ef="${esc(ek)}" value="${esc(v)}"/>${esc(v)}</label>`;
    html+='</div></div>'}
  c.innerHTML=html}

// ── Wire all events ──────────────────────────────────────────────────────
function wire(){
  // Tab switching
  $$(".tab").forEach(t=>t.addEventListener("click",()=>switchToTab(t.dataset.tab)));
  // Search
  const doS=()=>upd({q:$("#q").value});
  $("#btn-search").addEventListener("click",doS);
  $("#q").addEventListener("keydown",e=>{if(e.key==="Enter")doS()});
  let deb;$("#q").addEventListener("input",()=>{clearTimeout(deb);deb=setTimeout(doS,150)});
  // Category chips
  $("#cat-chips").addEventListener("change",e=>{const cb=e.target;if(!(cb instanceof HTMLInputElement))return;
    if(cb.checked)S.cats.add(cb.value);else S.cats.delete(cb.value);cb.closest(".chip").classList.toggle("on",cb.checked);renderFinder()});
  // Dynamic filters (bool + enum) — event delegation on container
  $("#dyn-filters").addEventListener("change",e=>{const cb=e.target;if(!(cb instanceof HTMLInputElement))return;
    if(cb.dataset.bf){S.boolToggles[cb.dataset.bf]=cb.checked;cb.closest(".chip").classList.toggle("on",cb.checked);renderFinder()}
    if(cb.dataset.ef){const key=cb.dataset.ef;if(!S.enumSel[key])S.enumSel[key]=new Set();
      if(cb.checked)S.enumSel[key].add(cb.value);else S.enumSel[key].delete(cb.value);
      cb.closest(".chip").classList.toggle("on",cb.checked);renderFinder()}});
  // Sort
  document.addEventListener("change",e=>{const t=e.target;if(t instanceof HTMLInputElement&&t.name==="sort")upd({sortMode:t.value})});
  // Show closed toggle
  const sc=$("#show-closed");if(sc)sc.addEventListener("change",()=>upd({showClosed:sc.checked}));
  // Card clicks
  $("#results").addEventListener("click",e=>{const c=e.target.closest(".card");if(!c)return;upd({selId:c.dataset.id});
    const f=S.resources.find(x=>x.id===c.dataset.id);if(f)renderDetail(f)});
  $("#results").addEventListener("keydown",e=>{if(e.key!=="Enter")return;const c=e.target.closest(".card");if(!c)return;
    upd({selId:c.dataset.id});const f=S.resources.find(x=>x.id===c.dataset.id);if(f)renderDetail(f)});
  // FIX #1: Cross-filtering — ZIP card clicks switch to Finder tab
  $("#zip-grid").addEventListener("click",e=>{
    const card=e.target.closest(".zip-card");
    if(!card||!card.dataset.zip)return;
    crossFilterZip(card.dataset.zip);
  });
  // Cross-filtering — crisis event clicks (if they have a ZIP)
  $("#events").addEventListener("click",e=>{
    const ev=e.target.closest(".event");
    if(!ev||!ev.dataset.zip)return;
    crossFilterZip(ev.dataset.zip);
  });
  // Priority 6: Keyboard shortcuts (1/2/3 for tabs, / for search)
  document.addEventListener("keydown",e=>{
    if(e.target.tagName==="INPUT"||e.target.tagName==="TEXTAREA")return;
    if(e.key==="1")switchToTab("dashboard");
    else if(e.key==="2"){switchToTab("finder");e.preventDefault()}
    else if(e.key==="3")switchToTab("data");
    else if(e.key==="/"){e.preventDefault();switchToTab("finder");setTimeout(()=>$("#q").focus(),50)}
  });
}

