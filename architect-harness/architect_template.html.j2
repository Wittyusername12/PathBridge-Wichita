    <details class="chat-faq" id="chatFaq" data-prov-block="{{ PB.python | e }}" style="padding:6px 12px;font-size:12px"><summary style="cursor:pointer;font-weight:600">Quick answers (no AI)</summary>{% for item in chat_faq %}<p style="margin:6px 0"><strong>{{ item.q | e }}</strong><br>{{ item.a | e }}</p>{% endfor %}</details>
