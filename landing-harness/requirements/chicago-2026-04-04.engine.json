{
  "schema_version": 1,
  "challenge": "chicago-2026-04-04",
  "_note": "BUILD B1 (D1, D3): the prioritization model's published table for Chicago — one option set (the clinics a displaced patient can reach) and two presets labeled illustrative: the brief names no users, so no worked case speaks for a real person. BUILD B2: the intake for the Architect's Get Help tab — one step per attribute the clinics table reads (coverage, languages, needs), the options from the values the clinics hold; the two illustrative presets as its buttons.",
  "option_sets": [
    {
      "id": "clinics",
      "label": "A clinic for care now",
      "endpoint": "clinics",
      "name_field": "name",
      "gates": [
        {
          "id": "open",
          "label": "Open now",
          "rule": "open_now",
          "field": "openHours"
        },
        {
          "id": "coverage",
          "label": "Takes this person's coverage",
          "rule": "in_set",
          "field": "accepts",
          "attr": "coverage"
        },
        {
          "id": "capacity",
          "label": "Sees patients each day",
          "rule": "free_above_zero",
          "fields": [
            "capacityPerDay"
          ]
        }
      ],
      "factors": [
        {
          "id": "wait",
          "label": "Weeks to a first visit",
          "form": "inverse",
          "field": "waitWeeks",
          "ref": 6,
          "max": 35,
          "why": "urgency: a displaced patient goes without care until the first visit"
        },
        {
          "id": "language",
          "label": "Care in the person's language",
          "form": "match",
          "field": "languages",
          "attr": "languages",
          "max": 25,
          "why": "access: a visit the person can follow"
        },
        {
          "id": "service",
          "label": "Offers the care needed",
          "form": "match",
          "field": "specialties",
          "attr": "needs",
          "max": 25,
          "why": "fit: the service the person came for"
        },
        {
          "id": "capacity",
          "label": "Visits a day",
          "form": "ratio",
          "field": "capacityPerDay",
          "ref": 200,
          "max": 15,
          "why": "capacity: room for the patients the closures displaced"
        }
      ],
      "tie_breakers": [
        "wait",
        "capacity"
      ],
      "contact": {
        "hours": "openHours",
        "address": "address"
      },
      "show": [
        "type",
        "area"
      ]
    }
  ],
