      function frame(f) {
        var ev = "", data = [], lines = f.split("\n");
        for (var i = 0; i < lines.length; i++) {
          if (lines[i].indexOf("event:") === 0) ev = lines[i].slice(6).trim();
          else if (lines[i].indexOf("data:") === 0) data.push(lines[i].slice(5).replace(/^ /, ""));
        }
        if (!data.length) return;
        var o;
        try { o = JSON.parse(data.join("\n")); } catch (e) { return; }
        var t = o && o.type;
        if (ev === "error" || t === "error") { state = "error"; code = o && o.error && o.error.code ? String(o.error.code) : ""; return; }
        if (t === "content_block_delta" && o.delta && o.delta.type === "text_delta" && typeof o.delta.text === "string") {
          text += o.delta.text; bubble.innerHTML = md(untag(held(text))); box.scrollTop = box.scrollHeight;
        } else if (t === "message_delta" && o.delta && o.delta.stop_reason) {
          stop = o.delta.stop_reason;
        } else if (t === "message_stop") {
          state = "stopped";
        }
      }
      /* Frames end at a blank line; lines end with LF, CRLF or CR. A trailing lone CR waits for the next chunk. */
      function drain(final) {
        var keep = !final && buf.charAt(buf.length - 1) === "\r";
        var s = (keep ? buf.slice(0, -1) : buf).replace(/\r\n?/g, "\n");
        var parts = s.split("\n\n"), rest = parts.pop();
        buf = rest + (keep ? "\r" : "");
        for (var i = 0; i < parts.length && state === "open"; i++) frame(parts[i]);
        if (final && state === "open" && rest.trim()) frame(rest);
      }
      function finish() {
        if (state === "stopped" && stop === "end_turn") {
          if (!text.trim()) { showError(bubble, MSG._empty); return end(false); }
          bubble.innerHTML = md(untag(text));             /* BUILD IC-5 (D11): the whole answer, a held tail included */
          history.push({ role: "assistant", content: text }); trimHistory();
          busy = false; send.disabled = false;
          return true;
        }
        if (state === "stopped" && stop === "max_tokens") { showError(bubble, MSG._cut, text); return end(false); }
        if (state === "stopped" && stop === "refusal") {
          bubble.className = "chat-msg ai"; bubble.innerHTML = esc(MSG._refusal);
          history = []; busy = false; send.disabled = false;
          return false;
        }
        showError(bubble, MSG[code] || CUT, text);
        return end(false);
      }
      function pump() {
        return rd.read().then(function (res) {
          if (res.done) { buf += dec.decode(); drain(true); return finish(); }
          buf += dec.decode(res.value, { stream: true }); drain(false);
          if (state !== "open") { rd.cancel().catch(function () {}); return finish(); }
          return pump();
        });
      }
      return pump();
    }).catch(function () { showError(bubble, MSG._unreachable, text); return end(false); });
  }
  send.addEventListener("click", function () { ask(input.value); });
  input.addEventListener("keydown", function (e) { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); ask(input.value); } });
  var chips = document.querySelectorAll(".chat-chip[data-q]");
  for (var i = 0; i < chips.length; i++) chips[i].addEventListener("click", function () {
    var q = this.getAttribute("data-q");
    if (q) { ask(q); if (this.parentElement) this.parentElement.style.display = "none"; }
  });
  window.openChatbot = function (q) { openPanel(); return ask(q); };
  var asks = document.querySelectorAll(".ask-ai-btn[data-ask]");
  for (var k = 0; k < asks.length; k++) asks[k].addEventListener("click", function () {
    var t = this.getAttribute("data-ask");
    if (t) window.openChatbot("What evidence supports the finding: " + t + "? Cite the specific data sources and explain.");
  });
  window.ChatReader = { ask: ask, history: function () { return history.slice(); }, codes: function () { return Object.keys(MSG); } };
})();
/* === END CHAT READER === */

/* === WHAT-IF SIMULATOR === */
  if(window.SIM_MODEL && Object.keys(SIM_MODEL).length>0){(function(){
    var M=SIM_MODEL;
    var sliderBen=document.getElementById("simBen");
    var sliderCV=document.getElementById("simCV");
    if(!sliderBen||!sliderCV)return;

    /* Configure sliders from Python-injected ranges */
    sliderBen.min=M.ranges.ben_min;sliderBen.max=M.ranges.ben_max;sliderBen.step=M.ranges.ben_step;sliderBen.value=M.defaults.beneficiaries;
    sliderCV.min=M.ranges.cv_min;sliderCV.max=M.ranges.cv_max;sliderCV.step=M.ranges.cv_step;sliderCV.value=M.defaults.contract;

    /* Generate tick labels */
    /* BUILD IC-5 (D2 g): each tick a <span> whose text is set as text, not a string of markup */
    function makeTicks(el,min,max,fmt){el.textContent="";for(var v=min;v<=max;v+=Math.round((max-min)/3)){var t=document.createElement("span");t.textContent=fmt(v);el.appendChild(t)}}
    var L=window.SIM_L||{};var budgetWord=L.budget||"Budget";var unitsWord=L.units||"beneficiaries";   /* P0.6 review F1 */
    makeTicks(document.getElementById("simBenTicks"),M.ranges.ben_min,M.ranges.ben_max,fmtBen);
    makeTicks(document.getElementById("simCVTicks"),M.ranges.cv_min,M.ranges.cv_max,function(v){return "$"+(v/1000)+"K"});

    /* AnimatedNumber with shared rAF loop and interrupt support */
    var animInstances=new Set();var animRaf=null;
    function animTick(ts){animInstances.forEach(function(a){a._frame(ts)});animRaf=animInstances.size>0?requestAnimationFrame(animTick):null}
    function AnimNum(el,opts){
      opts=opts||{};this.el=el;this.dur=opts.duration||220;this.prefix=opts.prefix||"";this.suffix=opts.suffix||"";
      this.dec=opts.decimals||0;this.fmt=opts.fmt||null;this.cur=opts.initial||0;this.start=this.cur;this.end=this.cur;this.t0=null;this.active=false;this._render(this.cur)
    }
    AnimNum.prototype.set=function(v){if(v===this.end&&!this.active)return;this.start=this.cur;this.end=v;this.t0=null;if(!this.active){this.active=true;animInstances.add(this);if(!animRaf)animRaf=requestAnimationFrame(animTick)}};
    AnimNum.prototype._frame=function(ts){if(!this.t0)this.t0=ts;var p=Math.min((ts-this.t0)/this.dur,1);var e=1-Math.pow(1-p,3);this.cur=this.start+(this.end-this.start)*e;this._render(this.cur);if(p>=1){this.cur=this.end;this._render(this.end);this.active=false;animInstances.delete(this)}};
    AnimNum.prototype._render=function(v){if(this.fmt){this.el.textContent=this.fmt(v);return}var a=Math.abs(v).toFixed(this.dec);var parts=a.split(".");parts[0]=parts[0].replace(/\B(?=(\d{3})+(?!\d))/g,",");var sign=v<0?"-":"";this.el.textContent=this.prefix+sign+parts.join(".")+this.suffix};

    /* Initialize animated numbers using computeMetrics (single source of truth) */
    function computeMetrics(ben,cv){
      var varTotal=M.variable_cost_per_ben*ben;
      var direct=M.fixed_costs+varTotal;
      var indirect=Math.round(direct*M.indirect_rate);
      var total=direct+indirect;
      var cpb=ben>0?Math.round(total/ben):0;
      var surplus=cv-total;
      var sv=ben*M.social_value_per_ben;
      var rawSroi=total>0?sv/total:0;
      /* Epsilon of 0.05 prevents false "capped" display from floating-point
         precision loss in the svpb derivation chain. At rawSroi=4.02 the
         displayed value rounds to 4.0 anyway; "capped" only adds information
         when rawSroi >= 4.05 (would display as 4.1+ without the cap). */
      return {cpb:cpb,surplus:Math.round(surplus),sroi:rawSroi}   /* B3 (D1): never capped */
    }

    var initR=computeMetrics(M.defaults.beneficiaries,M.defaults.contract);
    var animCPB=new AnimNum(document.getElementById("simCpbVal"),{prefix:"$",decimals:0,initial:initR.cpb});
    var animSur=new AnimNum(document.getElementById("simSurVal"),{prefix:"$",decimals:0,initial:initR.surplus});
    var animSROI=new AnimNum(document.getElementById("simSroiVal"),{fmt:function(v){return sig2(v)+" : 1"},initial:initR.sroi});   /* B3 (D1): the registry's form */

    /* Cost breakdown for chart */
    function computeChart(ben,cv){
      var varTotal=M.variable_cost_per_ben*ben;
      var direct=M.fixed_costs+varTotal;
      var indirect=Math.round(direct*M.indirect_rate);
      var total=direct+indirect;
      return {
        bars:[M.y1_costs.personnel/1000, varTotal/1000, M.y1_costs.technology/1000, indirect/1000],
        threshold:cv/1000, total:total/1000
      }
    }

    /* Slider fill gradient */
    function updateFill(slider){
      var pct=((slider.value-slider.min)/(slider.max-slider.min))*100;
      slider.style.backgroundSize=pct+"% 100%";
    }
    updateFill(sliderBen);updateFill(sliderCV);

    /* Format helpers */
    function fmtK(v){return v>=1000?"$"+(v/1000|0)+"K":v>=0?"$"+v:"−$"+Math.abs(v>=1000?(v/1000|0):v)+(Math.abs(v)>=1000?"K":"")}
    function fmtBen(v){return v>=1000?(Math.round(v/100)/10)+"K":String(v)}   /* P0.6 review F1: 600 reads "600", not "0.6K" */

    /* Display value labels */
    document.getElementById("simBenVal").textContent=fmtBen(M.defaults.beneficiaries);
    document.getElementById("simCVVal").textContent=fmtK(M.defaults.contract);

    /* Threshold colors */
    function applyThresholds(r){
      var cpbEl=document.getElementById("simCpbVal");
      var surEl=document.getElementById("simSurVal");
      var sroiEl=document.getElementById("simSroiVal");
      /* Deltas from base */
      var base=computeMetrics(M.defaults.beneficiaries,M.defaults.contract);
      /* P0.6 review F1: the cost colour compares with this plan's own base case, not a fixed $40/$50 (one event's scale) */
      cpbEl.style.color=r.cpb>base.cpb?"#ffaa00":"#4ade80";
      surEl.style.color=r.surplus>=0?"#4ade80":"#ff4444";
      sroiEl.style.color=r.sroi>=1?"#4ade80":"#ffaa00";   /* B3 (D1): below 1 in the warn colour */

      var dcpb=r.cpb-base.cpb;var dsur=r.surplus-base.surplus;
      var cpbD=document.getElementById("simCpbDelta");var surD=document.getElementById("simSurDelta");var sroiD=document.getElementById("simSroiDelta");
      cpbD.textContent=Math.abs(dcpb)>0?(dcpb>0?"▲ +$":"▼ −$")+Math.abs(dcpb)+" from base":"";
      cpbD.style.color=dcpb>0?"#ff4444":"#4ade80";
      surD.textContent=r.surplus<0?"▼ DEFICIT":"";surD.style.color="#ff4444";
      if(r.surplus>=0&&Math.abs(dsur)>0){surD.textContent=(dsur>0?"▲ +$":"▼ −$")+(Math.abs(dsur)/1000|0)+"K from base";surD.style.color=dsur>0?"#4ade80":"#ffaa00"}
      sroiD.textContent=r.sroi<1?"below 1 on the outcomes modeled":"";sroiD.style.color="var(--dim)";

      /* Modified border on metric cards */
      var modified=parseInt(sliderBen.value)!==M.defaults.beneficiaries||parseInt(sliderCV.value)!==M.defaults.contract;
      document.querySelectorAll(".sim-metric").forEach(function(c){c.classList.toggle("modified",modified)});
      document.getElementById("simReset").classList.toggle("show",modified);
    }

    /* Chart initialization — waits for Chart.js */
    var simChart=null;
    function initSimChart(){
      if(typeof Chart==="undefined")return;
      var ctx=document.getElementById("simChart");if(!ctx)return;
      var init=computeChart(M.defaults.beneficiaries,M.defaults.contract);
      simChart=new Chart(ctx,{
        type:"bar",
        data:{
          labels:M.cost_labels,
          datasets:[
            {type:"bar",label:"Year 1 Costs",data:init.bars,backgroundColor:M.cost_colors,borderRadius:4,order:2,barPercentage:0.7},
            {type:"line",label:budgetWord,data:[init.threshold,init.threshold,init.threshold,init.threshold],
             borderColor:"#4ade80",borderWidth:2.5,borderDash:[6,3],pointRadius:0,fill:false,order:1}
          ]
        },
        options:{
          responsive:true,maintainAspectRatio:false,
          animation:false,
          layout:{padding:{left:4,right:4,top:8}},
          plugins:{
            legend:{display:true,position:"bottom",labels:{boxWidth:10,boxHeight:10,padding:8,font:{size:10}}},
            tooltip:{callbacks:{label:function(i){return i.dataset.label+": $"+Math.round(i.raw)+"K"}}}
          },
          scales:{
            x:{grid:{display:false},ticks:{font:{size:10}}},
            y:{min:0,max:M.y_max/1000,grid:{color:"rgba(255,255,255,.06)"},ticks:{padding:8,font:{size:10},callback:function(v){return "$"+v+"K"}}}
          }
        }
      });
    }

    /* Main update handler */
    var ticking=false;
    function onInput(){
      var ben=parseInt(sliderBen.value);var cv=parseInt(sliderCV.value);
      updateFill(sliderBen);updateFill(sliderCV);
      document.getElementById("simBenVal").textContent=fmtBen(ben);
      document.getElementById("simCVVal").textContent=fmtK(cv);
      sliderBen.setAttribute("aria-valuetext",ben.toLocaleString("en-US")+" "+unitsWord);
      sliderCV.setAttribute("aria-valuetext","$"+(cv/1000)+"K "+budgetWord.toLowerCase());

      var r=computeMetrics(ben,cv);
      animCPB.set(r.cpb);animSur.set(r.surplus);animSROI.set(r.sroi);
      applyThresholds(r);

      /* Throttle chart redraw to 1/frame */
      if(!ticking&&simChart){requestAnimationFrame(function(){
        var c=computeChart(ben,cv);
        simChart.data.datasets[0].data=c.bars;
        simChart.data.datasets[1].data=[c.threshold,c.threshold,c.threshold,c.threshold];
        simChart.update("none");
        ticking=false;
      });ticking=true}
    }
    sliderBen.addEventListener("input",onInput);
    sliderCV.addEventListener("input",onInput);

    /* Reset */
    document.getElementById("simReset").addEventListener("click",function(){
      sliderBen.value=M.defaults.beneficiaries;sliderCV.value=M.defaults.contract;
      onInput();
    });

    /* Print handler: populate static fallback */
    window.addEventListener("beforeprint",function(){
      document.getElementById("simPrintBen").textContent=parseInt(sliderBen.value).toLocaleString("en-US");
      document.getElementById("simPrintCV").textContent="$"+(parseInt(sliderCV.value)/1000)+"K";
      document.getElementById("simPrintCPB").textContent=document.getElementById("simCpbVal").textContent;
      document.getElementById("simPrintSur").textContent=document.getElementById("simSurVal").textContent;
      document.getElementById("simPrintSROI").textContent=document.getElementById("simSroiVal").textContent;
    });

    /* Initialize: run first computation + start chart when Chart.js ready */
    onInput();
    if(typeof Chart!=="undefined"){initSimChart()}
    else{var sp=setInterval(function(){if(typeof Chart!=="undefined"){clearInterval(sp);initSimChart()}},100);setTimeout(function(){clearInterval(sp)},8000)}
  })()}
})();
</script>
